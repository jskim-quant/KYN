}

.kyn-strategy .ttabs {
  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  margin-top: 40px !important;
  border: 1px solid #d6d6d6 !important;
}

.kyn-strategy .ttab {
  height: 84px !important;
  border: 0 !important;
  border-right: 1px solid #d6d6d6 !important;
