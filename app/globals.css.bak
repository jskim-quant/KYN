}

.kyn-strategy input.kyn.short {
  width: 170px !important;
}

.kyn-strategy .checks {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 18px !important;
}

.kyn-strategy .chk {
  display: inline-flex !important;
  min-height: 58px !important;
  align-items: center !important;
  gap: 12px !important;
  padding: 0 22px !important;
  border: 1px solid rgba(154, 123, 46, 0.35) !important;
  background: #fbfaf6 !important;
  color: var(--ink-soft) !important;
  font-size: 20px !important;
  font-weight: 600 !important;
}

.kyn-strategy .diag.block {
  overflow: hidden !important;
  margin: 64px 0 !important;
  padding: 0 !important;
}

.kyn-strategy .diag .dtop {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
}

.kyn-strategy .diag .dc {
  min-height: 250px !important;
  padding: 54px 58px !important;
  border-right: 1px solid #dedede !important;
  background: #fff !important;
}

.kyn-strategy .diag .dc:last-child {
  border-right: 0 !important;
}

.kyn-strategy .diag .dc.alert {
  background: rgba(140, 58, 44, 0.075) !important;
}

.kyn-strategy .diag .dc.save {
  background: rgba(44, 64, 52, 0.075) !important;
}

.kyn-strategy .diag .dl {
  color: var(--ink-faint) !important;
  font-size: 24px !important;
  font-weight: 600 !important;
  line-height: 1.3 !important;
}

.kyn-strategy .diag .dv {
  margin-top: 22px !important;
  color: var(--ink) !important;
  font-family: var(--serif) !important;
  font-size: 72px !important;
  font-weight: 400 !important;
  line-height: 0.98 !important;
  letter-spacing: -0.07em !important;
}

.kyn-strategy .diag .dc.alert .dv {
  color: var(--red) !important;
}

.kyn-strategy .diag .dc.save .dv {
  color: var(--green-ink) !important;
}

.kyn-strategy .diag .dsub {
  margin-top: 20px !important;
  color: var(--ink-faint) !important;
  font-size: 18px !important;
  line-height: 1.45 !important;
}

.kyn-strategy .diag .dmeta {
  display: flex !important;
  min-height: 96px !important;
  align-items: center !important;
  gap: 34px !important;
  padding: 0 58px !important;
  border-top: 1px solid #dedede !important;
  color: var(--ink-faint) !important;
  font-size: 24px !important;
  line-height: 1.3 !important;
}

.kyn-strategy .badge {
  display: inline-flex !important;
  height: 52px !important;
  align-items: center !important;
  gap: 12px !important;
  padding: 0 24px !important;
  border: 1px solid rgba(140, 58, 44, 0.35) !important;
  background: rgba(140, 58, 44, 0.04) !important;
  color: var(--red) !important;
  font-size: 22px !important;
  font-weight: 800 !important;
}

.kyn-strategy .badge .dot {
  width: 10px !important;
  height: 10px !important;
  background: var(--red) !important;
}

.kyn-strategy .qsec.block {
  overflow: hidden !important;
  margin: 64px 0 !important;
}

.kyn-strategy .qhead {
  display: grid !important;
  width: 100% !important;
  grid-template-columns: 84px 1fr 34px !important;
  gap: 40px !important;
  align-items: start !important;
  padding: 64px 64px 48px !important;
  border: 0 !important;
  background: #fff !important;
  text-align: left !important;
}

.kyn-strategy .qhead .qn {
  color: var(--gold-deep) !important;
  font-family: var(--serif) !important;
  font-size: 24px !important;
  font-weight: 400 !important;
  line-height: 1.2 !important;
}

.kyn-strategy .qhead h3 {
  margin: 0 !important;
  color: var(--ink) !important;
  font-family: var(--serif) !important;
  font-size: 42px !important;
  font-weight: 500 !important;
  line-height: 1.18 !important;
  letter-spacing: -0.075em !important;
}

.kyn-strategy .qhead .qd {
  display: block !important;
  margin-top: 16px !important;
  color: var(--ink-faint) !important;
  font-size: 24px !important;
  line-height: 1.45 !important;
}

.kyn-strategy .chev {
  width: 34px !important;
  height: 34px !important;
  margin-top: 4px !important;
  position: relative !important;
}

.kyn-strategy .chev::before {
  content: "" !important;
  position: absolute !important;
  top: 5px !important;
  left: 6px !important;
  width: 22px !important;
  height: 22px !important;
  border: solid #9aa0a6 !important;
  border-width: 0 2px 2px 0 !important;
  transform: rotate(225deg) !important;
}

.kyn-strategy .qsec[data-open="false"] .chev::before {
  top: 0 !important;
  transform: rotate(45deg) !important;
}

.kyn-strategy .qbody {
  padding: 0 64px 64px 148px !important;
}

.kyn-strategy .bracket,
.kyn-strategy .reducer,
.kyn-strategy .preserve,
.kyn-strategy .method-panel,
.kyn-strategy .money-panel {
  border: 1px solid #dedede !important;
  border-left: 3px solid var(--gold) !important;
  border-radius: 0 !important;
  background: #fbfbfb !important;
  padding: 48px !important;
}

.kyn-strategy .bracket-flow {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 28px !important;
  color: var(--ink) !important;
  font-size: 27px !important;
  font-weight: 900 !important;
}

.kyn-strategy .bracket-bar {
  display: grid !important;
  grid-template-columns: 1fr 1fr 1fr 1.4fr 2.6fr !important;
  gap: 6px !important;
  margin: 48px 0 34px !important;
}

.kyn-strategy .bracket-seg {
  min-height: 88px !important;
  border-top: 14px solid var(--gold) !important;
  padding-top: 22px !important;
}

.kyn-strategy .bracket-seg.top {
