/* KYN strategy analysis scale reset: keep the standalone design proportions sane. */
.kyn-strategy {
  max-width: 1240px !important;
  padding: 48px 40px 88px !important;
  color: var(--ink) !important;
  font-family: var(--sans) !important;
  font-size: 14px !important;
  line-height: 1.62 !important;
}

.kyn-strategy .crumb,
.kyn-strategy .section-label {
  color: var(--ink-faint) !important;
  font-size: 10px !important;
  font-weight: 600 !important;
  letter-spacing: 0.34em !important;
  line-height: 1.2 !important;
  text-transform: uppercase !important;
}

.kyn-strategy .pagehead {
  margin: 0 0 32px !important;
  padding: 0 0 30px !important;
  border-bottom: 1px solid var(--line) !important;
}

.kyn-strategy .pagehead h1 {
  margin: 10px 0 0 !important;
  color: var(--ink) !important;
  font-family: var(--serif) !important;
  font-size: 34px !important;
  font-weight: 400 !important;
  line-height: 1.22 !important;
  letter-spacing: -0.045em !important;
}

.kyn-strategy .pagehead p,
.kyn-strategy .pagehead .desc {
  margin-top: 12px !important;
  color: var(--ink-faint) !important;
  font-family: var(--sans) !important;
  font-size: 13px !important;
  font-weight: 400 !important;
  letter-spacing: 0.02em !important;
  line-height: 1.7 !important;
  text-transform: none !important;
}

.kyn-strategy .rule {
  margin: 0 0 28px !important;
}

.kyn-strategy .block,
.kyn-strategy .card.block,
.kyn-strategy .qsec,
.kyn-strategy .diag {
  border: 1px solid var(--line) !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}

.kyn-strategy .stepbar.block {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  min-height: 58px !important;
  margin: 0 0 26px !important;
  padding: 0 24px !important;
  border-left: 2px solid var(--gold) !important;
  background: #fbfbfb !important;
  color: var(--ink-soft) !important;
  font-size: 13px !important;
  letter-spacing: -0.01em !important;
}

.kyn-strategy .stepbar strong {
  color: var(--ink) !important;
  font-size: 13px !important;
  font-weight: 700 !important;
}

.kyn-strategy .card.block {
  margin: 0 0 30px !important;
  background: var(--paper) !important;
}

.kyn-strategy .card-head {
  padding: 30px 34px 22px !important;
}

.kyn-strategy .card-head .t {
  color: var(--ink) !important;
  font-size: 17px !important;
  font-weight: 700 !important;
  letter-spacing: -0.02em !important;
}

.kyn-strategy .card-head .sub {
  display: block !important;
  margin-top: 8px !important;
  color: var(--ink-faint) !important;
  font-size: 13px !important;
  font-weight: 400 !important;
  line-height: 1.65 !important;
}

.kyn-strategy .setbody {
  display: grid !important;
  gap: 30px !important;
  padding: 28px 34px 36px !important;
}

.kyn-strategy label {
  color: var(--ink) !important;
  font-size: 15px !important;
  font-weight: 700 !important;
  letter-spacing: -0.015em !important;
}

.kyn-strategy select.kyn,
.kyn-strategy input.kyn,
.kyn-strategy .kyn-input {
  height: 48px !important;
  padding: 0 16px !important;
  border: 1px solid var(--line-strong) !important;
  border-radius: 0 !important;
  background: var(--paper) !important;
  color: var(--ink) !important;
  font-family: var(--sans) !important;
  font-size: 15px !important;
  font-weight: 400 !important;
  line-height: 48px !important;
}

.kyn-strategy .chk {
  min-height: 42px !important;
  padding: 0 15px !important;
  border: 1px solid color-mix(in srgb, var(--gold) 48%, var(--line)) !important;
  background: var(--paper) !important;
  color: var(--ink-soft) !important;
  font-size: 14px !important;
  font-weight: 500 !important;
}

.kyn-strategy .fgrid {
  display: grid !important;
  grid-template-columns: minmax(180px, 280px) 1fr !important;
  gap: 34px 82px !important;
  align-items: end !important;
}

.kyn-strategy .diag.block {
  margin: 30px 0 40px !important;
  overflow: hidden !important;
  background: var(--paper) !important;
}

.kyn-strategy .diag .dtop {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
}

.kyn-strategy .diag .dc {
  min-height: 168px !important;
  padding: 34px 34px 26px !important;
  border-right: 1px solid var(--line) !important;
}

.kyn-strategy .diag .dl {
  margin: 0 0 20px !important;
  color: var(--ink-faint) !important;
  font-family: var(--sans) !important;
  font-size: 15px !important;
  font-weight: 500 !important;
  letter-spacing: -0.015em !important;
  line-height: 1.4 !important;
}

.kyn-strategy .diag .dv {
  color: var(--ink) !important;
  font-family: var(--serif) !important;
  font-size: 46px !important;
  font-weight: 400 !important;
  line-height: 1.04 !important;
  letter-spacing: -0.055em !important;
}

.kyn-strategy .diag .dv .u,
.kyn-strategy .diag .u {
  margin-left: 3px !important;
  color: var(--ink-faint) !important;
  font-family: var(--serif) !important;
  font-size: 22px !important;
  font-weight: 400 !important;
}

.kyn-strategy .diag .bad {
  color: var(--red) !important;
  background: color-mix(in srgb, var(--red) 7%, var(--paper)) !important;
}

.kyn-strategy .diag .good {
  color: var(--green-ink) !important;
  background: color-mix(in srgb, var(--green-ink) 7%, var(--paper)) !important;
}

.kyn-strategy .diag .dmeta {
  display: flex !important;
  align-items: center !important;
  gap: 24px !important;
  min-height: 66px !important;
  padding: 0 34px !important;
  border-top: 1px solid var(--line) !important;
  color: var(--ink-faint) !important;
  font-size: 15px !important;
  line-height: 1.45 !important;
}

.kyn-strategy .badge {
  display: inline-flex !important;
  align-items: center !important;
  min-height: 32px !important;
  padding: 0 14px !important;
  border: 1px solid color-mix(in srgb, var(--red) 24%, var(--line)) !important;
  border-radius: 0 !important;
  background: color-mix(in srgb, var(--red) 5%, var(--paper)) !important;
  color: var(--red) !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  letter-spacing: -0.02em !important;
}

.kyn-strategy .qsec.block,
.kyn-strategy .qsec {
  margin: 34px 0 !important;
  background: var(--paper) !important;
}

.kyn-strategy .qhead {
  display: grid !important;
  grid-template-columns: 76px 1fr 24px !important;
  gap: 28px !important;
  align-items: start !important;
  padding: 40px 48px 30px !important;
}

.kyn-strategy .qhead .qn {
  color: var(--gold-deep) !important;
  font-family: var(--serif) !important;
  font-size: 17px !important;
  font-weight: 400 !important;
  line-height: 1.6 !important;
}

.kyn-strategy .qhead h3 {
  margin: 0 !important;
  color: var(--ink) !important;
  font-family: var(--serif) !important;
  font-size: 28px !important;
  font-weight: 400 !important;
  line-height: 1.3 !important;
  letter-spacing: -0.045em !important;
}

.kyn-strategy .qhead .qd {
  margin-top: 8px !important;
  color: var(--ink-faint) !important;
  font-family: var(--sans) !important;
  font-size: 14px !important;
  font-weight: 400 !important;
  line-height: 1.65 !important;
  letter-spacing: -0.01em !important;
}

.kyn-strategy .qbody {
  padding: 0 48px 44px 124px !important;
}

.kyn-strategy .bracket,
.kyn-strategy .reducer,
.kyn-strategy .method-panel,
.kyn-strategy .preserve,
.kyn-strategy .money-panel {
  border: 1px solid var(--line) !important;
  border-left: 2px solid var(--gold) !important;
  border-radius: 0 !important;
  background: #fbfbfb !important;
  box-shadow: none !important;
}

.kyn-strategy .reducer {
  padding: 30px 34px !important;
}

.kyn-strategy .reducer .rh {
  display: grid !important;
  grid-template-columns: 1fr 124px !important;
  gap: 28px !important;
  align-items: start !important;
}

.kyn-strategy .reducer .rt {
  color: var(--ink) !important;
  font-family: var(--serif) !important;
  font-size: 23px !important;
  font-weight: 400 !important;
  line-height: 1.36 !important;
  letter-spacing: -0.045em !important;
}

.kyn-strategy .reducer .rd {
  margin-top: 10px !important;
  color: var(--ink-faint) !important;
  font-size: 13px !important;
  line-height: 1.75 !important;
  letter-spacing: -0.01em !important;
}

.kyn-strategy .reducer .rpct {
  min-height: 102px !important;
  padding: 14px 16px !important;
  border: 1px solid var(--line) !important;
  background: var(--paper) !important;
  text-align: center !important;
}

.kyn-strategy .reducer .rl {
  color: var(--ink-faint) !important;
  font-size: 11px !important;
  font-weight: 500 !important;
  letter-spacing: 0.02em !important;
}

.kyn-strategy .reducer .rv {
  margin-top: 8px !important;
  color: var(--gold-deep) !important;
  font-family: var(--serif) !important;
  font-size: 34px !important;
  font-weight: 400 !important;
  line-height: 1.05 !important;
  letter-spacing: -0.055em !important;
}

.kyn-strategy .reducer .rv span {
  margin-left: 2px !important;
  color: var(--ink-soft) !important;
  font-family: var(--serif) !important;
  font-size: 14px !important;
  font-weight: 400 !important;
}

.kyn-strategy .reducer input[type='range'] {
  height: 30px !important;
  margin: 28px 0 12px !important;
}

.kyn-strategy .reducer input[type='range']::-webkit-slider-runnable-track {
  height: 4px !important;
  border-radius: 0 !important;
  background: var(--line-strong) !important;
}

.kyn-strategy .reducer input[type='range']::-webkit-slider-thumb {
  width: 18px !important;
  height: 18px !important;
  margin-top: -7px !important;
  border: 2px solid var(--gold) !important;
  border-radius: 999px !important;
  background: var(--paper) !important;
}

.kyn-strategy .preset {
  height: 34px !important;
  min-width: 50px !important;
  padding: 0 14px !important;
  border: 1px solid var(--line-strong) !important;
  border-radius: 0 !important;
  background: var(--paper) !important;
  color: var(--ink-soft) !important;
  font-size: 13px !important;
  font-weight: 600 !important;
}

.kyn-strategy .preset.active {
  border-color: var(--ink) !important;
  background: var(--ink) !important;
  color: var(--paper) !important;
}

.kyn-strategy .rmini {
  display: grid !important;
  grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
  gap: 0 !important;
  margin-top: 22px !important;
  border: 1px solid var(--line) !important;
  background: var(--paper) !important;
}

.kyn-strategy .rmini .rc,
.kyn-strategy .rmini > div {
  min-height: 72px !important;
  padding: 14px 16px !important;
  border: 0 !important;
  border-right: 1px solid var(--line) !important;
  background: transparent !important;
}

.kyn-strategy .rmini .rc:last-child,
.kyn-strategy .rmini > div:last-child {
  border-right: 0 !important;
}

.kyn-strategy .rmini .rcl,
.kyn-strategy .rmini .text-xs {
  color: var(--ink-faint) !important;
  font-size: 11px !important;
  line-height: 1.45 !important;
}

.kyn-strategy .rmini .rcv,
.kyn-strategy .rmini .font-bold {
  margin-top: 4px !important;
  color: var(--ink) !important;
  font-family: var(--sans) !important;
  font-size: 17px !important;
  font-weight: 700 !important;
  line-height: 1.35 !important;
}

.kyn-strategy .rnote {
  margin-top: 16px !important;
  padding: 16px 18px !important;
  border: 1px solid var(--line) !important;
  background: var(--paper) !important;
  color: var(--ink-soft) !important;
  font-size: 13px !important;
  line-height: 1.8 !important;
}

@media (max-width: 980px) {
  .kyn-strategy {
    padding: 34px 20px 72px !important;
  }

  .kyn-strategy .diag .dtop,
  .kyn-strategy .rmini {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }

  .kyn-strategy .fgrid {
    grid-template-columns: 1fr !important;
  }

  .kyn-strategy .qhead {
    grid-template-columns: 48px 1fr 24px !important;
    padding: 32px 28px 24px !important;
  }

  .kyn-strategy .qbody {
    padding: 0 28px 36px !important;
  }
}

/* ================================================================
   KYN Strategy — FINAL typography & proportion reset
   HTML 레퍼런스(KYN 전략분석 단독.html) 기준으로 모든 크기 정규화
   ================================================================ */

/* ── 페이지 헤더 ── */
.kyn-strategy .crumb { font-size: 11.5px !important; letter-spacing: 0.2em !important; }
.kyn-strategy .pagehead h1 { font-size: 31px !important; font-weight: 500 !important; letter-spacing: -0.02em !important; font-family: var(--serif) !important; }
.kyn-strategy .pagehead .desc { font-size: 13.5px !important; font-weight: 400 !important; }
.kyn-strategy .stepbar b { font-size: 14px !important; font-weight: 600 !important; }
.kyn-strategy .stepbar span { font-size: 13px !important; }

/* ── 카드 헤더 ── */
.kyn-strategy .card-head .t { font-size: 15px !important; font-weight: 600 !important; letter-spacing: -0.01em !important; }
.kyn-strategy .card-head .t .sub { font-size: 12.5px !important; font-weight: 400 !important; }
.kyn-strategy .flab { font-size: 12.5px !important; font-weight: 600 !important; }
.kyn-strategy .chk { font-size: 13.5px !important; }

/* ── 현황 진단 배너 (SituationBanner .diag) ── */
.kyn-strategy .diag .dl { font-size: 12px !important; font-weight: 500 !important; margin-bottom: 12px !important; letter-spacing: 0 !important; }
.kyn-strategy .diag .dv { font-family: var(--serif) !important; font-size: 34px !important; font-weight: 500 !important; line-height: 1 !important; letter-spacing: -0.02em !important; }
.kyn-strategy .diag .dv .u { font-size: 16px !important; }
.kyn-strategy .diag .dsub { font-size: 11px !important; margin-top: 9px !important; }
.kyn-strategy .diag .dc { min-height: auto !important; padding: 22px 26px !important; }
.kyn-strategy .diag .dmeta { font-size: 13px !important; padding: 15px 26px !important; }

/* ── 스텝 아코디언 ── */
.kyn-strategy .qhead .qn { font-size: 14px !important; font-weight: 500 !important; letter-spacing: 0 !important; }
.kyn-strategy .qhead h3 { font-size: 17px !important; font-weight: 600 !important; letter-spacing: -0.01em !important; font-family: var(--serif) !important; }
.kyn-strategy .qhead .qd { font-size: 12.5px !important; font-weight: 400 !important; }
.kyn-strategy .qhead { min-height: auto !important; padding: 22px 26px !important; grid-template-columns: 30px 1fr 22px !important; gap: 16px !important; }

/* ── 리듀서 (증여 비중 슬라이더) ── */
.kyn-strategy .reducer .rt { font-size: 14.5px !important; font-weight: 600 !important; }
.kyn-strategy .reducer .rd { font-size: 12.5px !important; line-height: 1.55 !important; }
.kyn-strategy .reducer .rpct .rl { font-size: 11.5px !important; }
.kyn-strategy .reducer .rpct .rv { font-size: 32px !important; font-weight: 500 !important; letter-spacing: -0.02em !important; }
.kyn-strategy .section-label { font-size: 12px !important; letter-spacing: 0.22em !important; font-weight: 500 !important; color: var(--gold-deep) !important; }
.kyn-strategy .reducer .pct-unit { font-size: 16px !important; }
.kyn-strategy .rmini .rcl { font-size: 11px !important; font-weight: 500 !important; color: var(--ink-faint) !important; margin-bottom: 7px !important; }
.kyn-strategy .rmini .rcv { font-size: 17px !important; font-weight: 600 !important; letter-spacing: -0.01em !important; line-height: 1.2 !important; margin-top: 0 !important; }
.kyn-strategy .rnote { font-size: 13px !important; line-height: 1.65 !important; padding: 14px 18px !important; margin-top: 12px !important; }
.kyn-strategy .rnote-sub { font-size: 12px !important; margin-top: 10px !important; display: block !important; }

/* ── 전략 탭 & 카드 ── */
.kyn-strategy .ttab { font-size: 13.5px !important; font-weight: 500 !important; height: auto !important; padding: 14px !important; }
.kyn-strategy .strat { min-height: auto !important; padding: 18px 22px !important; display: grid !important; grid-template-columns: 22px 1fr auto !important; gap: 16px !important; align-items: center !important; }
.kyn-strategy .strat .stags { margin-bottom: 6px !important; }
.kyn-strategy .strat .timing { font-size: 11px !important; font-weight: 500 !important; padding: 3px 8px !important; }
.kyn-strategy .strat .diff { font-size: 11.5px !important; font-weight: 500 !important; }
.kyn-strategy .strat .stitle { font-size: 14.5px !important; font-weight: 600 !important; line-height: 1.3 !important; }
.kyn-strategy .strat .slaw { font-size: 12px !important; margin-top: 4px !important; }
.kyn-strategy .strat .simp .il { font-size: 11px !important; }
.kyn-strategy .strat .simp .iv { font-size: 19px !important; font-weight: 500 !important; font-family: var(--serif) !important; color: var(--green-ink) !important; letter-spacing: -0.01em !important; margin-top: 2px !important; }
.kyn-strategy .strat .simp .iv.muted { font-size: 13px !important; font-family: var(--sans) !important; color: var(--ink-faint) !important; }
.kyn-strategy .strat .title { font-size: 14.5px !important; font-weight: 600 !important; }
.kyn-strategy .strat .desc { font-size: 12.5px !important; font-weight: 400 !important; }
.kyn-strategy .stratfoot { font-size: 13px !important; padding: 16px 22px !important; }

/* ── 저장 패널 ── */
.kyn-strategy .save-panel.block { margin: 32px 0 !important; }
.kyn-strategy .save-panel-grid { padding: 32px 36px 28px !important; gap: 40px !important; grid-template-columns: minmax(0, 1fr) 360px !important; }
.kyn-strategy .save-kicker { font-size: 12.5px !important; font-weight: 600 !important; color: var(--gold-deep) !important; }
.kyn-strategy .save-title { font-size: 17px !important; font-weight: 600 !important; letter-spacing: -0.01em !important; margin-top: 10px !important; line-height: 1.3 !important; }
.kyn-strategy .save-desc { font-size: 13px !important; font-weight: 400 !important; line-height: 1.6 !important; margin-top: 10px !important; color: var(--ink-soft) !important; }
.kyn-strategy .save-tags { margin-top: 16px !important; gap: 8px !important; }
.kyn-strategy .save-tag { font-size: 12px !important; font-weight: 500 !important; min-height: auto !important; padding: 5px 12px !important; }
.kyn-strategy .save-empty { font-size: 13px !important; color: var(--ink-faint) !important; }
.kyn-strategy .save-form { padding: 22px 24px !important; }
.kyn-strategy .save-form label { font-size: 12.5px !important; font-weight: 600 !important; color: var(--ink-soft) !important; }
.kyn-strategy .save-input { min-height: 42px !important; font-size: 14px !important; margin-top: 8px !important; padding: 0 12px !important; }
.kyn-strategy .save-row { font-size: 13px !important; margin-top: 14px !important; color: var(--ink-soft) !important; }
.kyn-strategy .save-row strong { font-weight: 600 !important; color: var(--ink) !important; }
.kyn-strategy .save-note { font-size: 12px !important; margin-top: 10px !important; line-height: 1.55 !important; color: var(--ink-faint) !important; }
.kyn-strategy .save-footer { font-size: 13px !important; padding: 18px 36px !important; }
.kyn-strategy .save-actions { gap: 10px !important; }

/* ── 버튼 ── */
.kyn-strategy .btn-secondary { font-size: 13px !important; padding: 10px 18px !important; font-weight: 500 !important; }
.kyn-strategy .btn-primary { font-size: 13px !important; padding: 10px 18px !important; font-weight: 500 !important; }

/* ── 상속세 구간 ── */
.kyn-strategy .bracket-flow { font-size: 13px !important; gap: 12px !important; }
.kyn-strategy .bracket-flow strong { font-size: 14px !important; font-weight: 600 !important; }
.kyn-strategy .bracket-seg span { font-size: 12.5px !important; font-weight: 600 !important; }
.kyn-strategy .bracket-seg small { font-size: 11px !important; }
.kyn-strategy .bracket-metrics { font-size: 13px !important; }
.kyn-strategy .bracket-metrics strong { font-size: 17px !important; font-weight: 600 !important; }
.kyn-strategy .bracket-quote { font-size: 13px !important; line-height: 1.65 !important; }
.kyn-strategy .bt-title { font-size: 12px !important; font-weight: 600 !important; }
.kyn-strategy .bt-row { font-size: 12.5px !important; }

/* ── 각주 & 기타 ── */
.kyn-strategy .strategy-footnote { font-size: 12px !important; }
.kyn-strategy .asset-plan-note p { font-size: 13.5px !important; line-height: 1.7 !important; }
.kyn-strategy .asset-plan-link { font-size: 13px !important; }
.kyn-strategy .unit-muted { font-size: 11px !important; color: var(--ink-faint) !important; }

/* ── 반응형 ── */
@media (max-width: 820px) {
  .kyn-strategy .save-panel-grid { grid-template-columns: 1fr !important; gap: 24px !important; padding: 24px 22px 20px !important; }
  .kyn-strategy .save-footer { padding: 16px 22px !important; flex-wrap: wrap !important; gap: 14px !important; }
  .kyn-strategy .diag .dtop { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
  .kyn-strategy .strat { grid-template-columns: 22px 1fr !important; }
  .kyn-strategy .strat .simp { grid-column: 2 !important; }
}

/* hero-cta fix */
.kyn-strategy .hero-cta { min-width: auto !important; height: auto !important; padding: 12px 22px !important; font-size: 14px !important; font-weight: 500 !important; letter-spacing: 0 !important; }
