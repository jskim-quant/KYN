  font-size: 14px !important;
}

.kyn-strategy .fgrid {
  display: grid !important;
  grid-template-columns: minmax(220px, 0.58fr) minmax(440px, 1fr) !important;
  align-items: end !important;
  gap: 30px 66px !important;
}

.kyn-strategy .small-grid {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 20px !important;
}

.kyn-strategy .rowin {
  display: grid !important;
  grid-template-columns: auto minmax(86px, 112px) !important;
  align-items: center !important;
  gap: 8px !important;
}

.kyn-strategy .diag {
  margin: 28px 0 36px !important;
  border: 1px solid var(--line-strong) !important;
  background: var(--paper) !important;
  box-shadow: none !important;
}

.kyn-strategy .diag .dtop {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
}

.kyn-strategy .diag .dc {
  min-height: 174px !important;
  padding: 34px 36px 30px !important;
  border-right: 1px solid var(--line) !important;
  background: var(--paper) !important;
}

.kyn-strategy .diag .dc:last-child {
  border-right: 0 !important;
}

.kyn-strategy .diag .dc.alert {
  background: #f4ebe8 !important;
}

.kyn-strategy .diag .dc.save {
  background: #eef1ed !important;
}

.kyn-strategy .diag .dl,
.kyn-strategy .diag .dc.save .dl {
  margin: 0 0 18px !important;
  color: var(--ink-faint) !important;
  font-size: 16px !important;
  font-weight: 400 !important;
  letter-spacing: -0.025em !important;
}

.kyn-strategy .diag .dv {
  color: var(--ink) !important;
  font-family: var(--serif) !important;
  font-size: 54px !important;
  font-weight: 400 !important;
  line-height: 1 !important;
  letter-spacing: -0.055em !important;
}

.kyn-strategy .diag .dc.alert .dv {
