@tailwind base;
@tailwind components;
@tailwind utilities;

/* ── KYN Design System — 핸드오프 토큰 적용 ──────────────────── */
:root {
  --bg:          #FFFFFF;
  --paper:       #FAFAFA;
  --paper-sink:  #F4F4F5;
  --ink:         #1C1D1F;
  --ink-soft:    #4B4D52;
  --ink-faint:   #8A8D93;
  --ink-ghost:   rgba(20,21,24,0.05);
  --line:        rgba(20,21,24,0.10);
  --line-strong: rgba(20,21,24,0.20);
  --gold:        #9A7B2E;
  --gold-deep:   #7A5F22;
  --gold-bright: #C8A24E;
  --gold-tint:   rgba(154,123,46,0.10);
  --green:       #2C4034;
  --green-ink:   #21342A;
  --green-tint:  rgba(44,64,52,0.08);
  --amber:       #8A6420;
  --amber-tint:  rgba(138,100,32,0.10);
  --red:         #8C3A2C;
  --red-tint:    rgba(140,58,44,0.09);
  --legal:       #3F4D66;
  --legal-tint:  rgba(63,77,102,0.07);
  --serif: 'Noto Serif KR', Georgia, serif;
  --sans:  'Noto Sans KR', system-ui, -apple-system, sans-serif;
  --maxw: 1240px;
}


@layer base {
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    letter-spacing: -0.01em;
    word-break: keep-all;
  }

  /* 전역 sharp corners — 새 디자인 시스템은 라운드 없음 */
  *, *::before, *::after {
    border-radius: 0 !important;
  }
  /* 예외: 원형 아바타·프로필 컬러 칩 */
  .rounded-full { border-radius: 9999px !important; }
  .rounded-circle { border-radius: 50% !important; }
}

@layer components {
  /* ── Cards ── */
  .card {
    @apply bg-white border border-[#D8D8D6] p-5;
  }
  .metric-card {
    background: #F2F2F0;
    border: 1px solid #D8D8D6;
    padding: 18px 20px;
  }

  /* ── Buttons ── */
  .btn-primary {
    display: inline-block;
    padding: 10px 22px;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 500;
    background: #1E1E20;
    color: #FFFFFF;
    border: 1.5px solid #B8973A;
    cursor: pointer;
    transition: opacity 0.15s;
    text-decoration: none;
  }
  .btn-primary:hover { opacity: 0.85; }
  .btn-primary:disabled { background: #8E8E93; border-color: #8E8E93; cursor: not-allowed; }

  .btn-secondary {
    display: inline-block;
    padding: 9px 20px;
    font-size: 11px;
    font-weight: 400;
    background: #FFFFFF;
    color: #48484A;
    border: 1px solid #D8D8D6;
    cursor: pointer;
    transition: background 0.15s;
    text-decoration: none;
  }
  .btn-secondary:hover { background: #F2F2F0; }

  .btn-danger {
    display: inline-block;
    padding: 6px 14px;
    font-size: 10px;
    font-weight: 400;
    background: #FFFFFF;
    color: #8E8E93;
    border: 1px solid #D8D8D6;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .btn-danger:hover { color: #B22222; border-color: #B22222; }

  /* ── Form controls ── */
  .input {
    width: 100%;
    padding: 10px 12px;
    font-size: 13px;
    border: 1px solid #D8D8D6;
    background: #FFFFFF;
    color: #1E1E20;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
  }
  .input:focus { border-color: #B8973A; }
  .input::placeholder { color: #8E8E93; }

  .select {
    width: 100%;
    padding: 10px 12px;
    font-size: 13px;
    border: 1px solid #D8D8D6;
    background: #FFFFFF;
    color: #1E1E20;
    font-family: inherit;
    outline: none;
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%238E8E93' stroke-width='1.5'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 12px center;
    padding-right: 32px;
  }
  .select:focus { border-color: #B8973A; outline: none; }

  .label {
    display: block;
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #8E8E93;
    margin-bottom: 7px;
    font-weight: 400;
  }

  /* ── Badges ── */
  .badge-green  { @apply inline-flex items-center px-2 py-0.5 text-xs font-medium bg-green-50 text-green-800 border border-green-200; }
  .badge-red    { @apply inline-flex items-center px-2 py-0.5 text-xs font-medium bg-red-50 text-red-700 border border-red-200; }
  .badge-amber  { @apply inline-flex items-center px-2 py-0.5 text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200; }
  .badge-blue   { @apply inline-flex items-center px-2 py-0.5 text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200; }

  /* ── Status boxes ── */
  .error-box   { background: #FFF5F5; border: 1px solid #FECACA; border-left: 2px solid #DC2626; color: #7F1D1D; font-size: 12px; padding: 10px 14px; }
  .success-box { background: #F0FDF4; border: 1px solid #BBF7D0; border-left: 2px solid #16A34A; color: #14532D; font-size: 12px; padding: 10px 14px; }

  /* ── Page header ── */
  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 20px;
    margin-bottom: 28px;
    border-bottom: 1px solid #D8D8D6;
  }
  .page-title {
    font-family: var(--serif);
    font-size: 31px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .page-sub {
    font-size: 11px;
    color: #8E8E93;
    letter-spacing: 0.5px;
  }

  /* ── Section label ── */
  .section-label {
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8E8E93;
    margin-bottom: 12px;
  }

  /* ── Table ── */
  .kyn-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .kyn-table th { font-size: 9px; letter-spacing: 1px; text-transform: uppercase; color: #8E8E93; font-weight: 400; padding: 0 12px 10px; border-bottom: 1px solid #D8D8D6; }
  .kyn-table th:first-child { padding-left: 0; }
  .kyn-table td { padding: 12px; color: #1E1E20; border-bottom: 1px solid #F2F2F0; vertical-align: middle; }
  .kyn-table td:first-child { padding-left: 0; }
  .kyn-table tr:last-child td { border-bottom: none; }
}

/* ── Start Page (Landing) ──────────────────────────────────── */
.lp { min-height: 100vh; display: flex; flex-direction: column; font-family: var(--sans); background: var(--bg); color: var(--ink); -webkit-font-smoothing: antialiased; letter-spacing: -0.01em; word-break: keep-all; }
.lp-nav { display: flex; align-items: center; justify-content: space-between; padding: 22px 48px; border-bottom: 1px solid var(--line); background: var(--bg); position: relative; z-index: 5; }
.lp-nav-right { display: flex; align-items: center; gap: 22px; }
.lp-navlink { font-size: 14px; color: var(--ink-soft); text-decoration: none; font-weight: 500; }
.lp-navlink:hover { color: var(--ink); }
.lp-btn-sm { font-size: 14px; font-weight: 500; padding: 10px 20px; text-decoration: none; border: 1px solid var(--line-strong); color: var(--ink); transition: border-color .18s; }
.lp-btn-sm:hover { border-color: var(--ink); }
.kyn-wordmark {
  font-family: var(--serif);
  font-weight: 500;
  font-size: 25px;
  letter-spacing: 0.06em;
  color: var(--ink);
  display: inline-block;
  text-decoration: none;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.kyn-wordmark::first-letter { color: var(--gold); }
.lp-split { flex: 1; display: grid; grid-template-columns: 1.18fr 1fr; }
.lp-left  { position: relative; overflow: hidden; padding: 7vh 56px; display: flex; flex-direction: column; justify-content: center; }
.lp-right { border-left: 1px solid var(--line); padding: 7vh 52px; display: flex; flex-direction: column; justify-content: center; gap: 38px; background: #F5F5F6; }
.hero { position: relative; z-index: 2; max-width: 560px; }
.hero-eyebrow { font-size: 12px; letter-spacing: 0.22em; font-weight: 500; color: var(--gold-deep); display: inline-flex; align-items: center; gap: 10px; margin-bottom: 40px; }
.hero-eyebrow::before { content: ""; width: 22px; height: 1px; background: var(--gold); display: inline-block; }
.lp-h1 { font-family: var(--serif); font-weight: 500; margin: 0; font-size: clamp(54px, 8.5vw, 104px); line-height: 1.0; letter-spacing: -0.04em; }
.hero-line2 { display: block; font-size: clamp(26px, 3.6vw, 44px); font-weight: 300; color: var(--ink-soft); letter-spacing: 0.06em; margin-top: 18px; }
.hero-sub { margin: 40px 0 46px; font-size: clamp(15px, 1.5vw, 17px); line-height: 1.9; color: var(--ink-soft); }
.hero-sub strong { color: var(--ink); font-weight: 500; }
.cta-row { display: flex; align-items: center; gap: 26px; flex-wrap: wrap; }
.cta-primary { font-size: 15px; font-weight: 500; padding: 16px 26px; background: var(--ink); color: #F4F2EC; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; transition: background .18s; border: 1px solid transparent; }
.cta-primary:hover { background: #000; }
.cta-link { font-size: 14.5px; color: var(--ink-soft); text-decoration: none; font-weight: 500; display: inline-flex; gap: 8px; }
.cta-link:hover { color: var(--ink); }
.col-label { font-size: 12px; letter-spacing: 0.18em; color: var(--ink-faint); font-weight: 500; margin-bottom: 18px; }
.qlist { display: flex; flex-direction: column; }
.qitem { display: grid; grid-template-columns: 30px 1fr; gap: 14px; padding: 18px 0; border-top: 1px solid var(--line); }
.qitem:first-of-type { border-top: none; padding-top: 0; }
.qn { font-family: var(--serif); font-size: 13px; color: var(--gold-deep); font-weight: 500; padding-top: 2px; }
.qitem h4 { margin: 0 0 6px; font-size: 15.5px; font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
.qitem p { margin: 0; font-size: 13px; line-height: 1.6; color: var(--ink-faint); }
.tools { display: flex; flex-direction: column; }
.tool { padding: 15px 0; border-top: 1px solid var(--line); }
.tool:first-of-type { border-top: none; padding-top: 0; }
.tool-t { font-size: 14.5px; font-weight: 600; color: var(--ink); }
.tool-d { font-size: 12.5px; color: var(--ink-faint); margin-top: 3px; }
@media (max-width: 880px) {
  .lp-nav { padding: 18px 22px; }
  .lp-split { grid-template-columns: 1fr; }
  .lp-left { padding: 56px 24px 46px; min-height: 78vh; }
  .lp-right { border-left: none; border-top: 1px solid var(--line); padding: 44px 24px; gap: 32px; }
  .lp-h1 { font-size: clamp(48px, 17vw, 76px); }
  .hero-eyebrow { margin-bottom: 28px; }
  .hero-sub { margin: 30px 0 34px; }
}
@media (max-width: 420px) {
  .cta-row { flex-direction: column; align-items: stretch; gap: 16px; }
  .cta-primary { justify-content: center; }
  .cta-link { justify-content: center; }
}

/* ============================================================
   KYN — App shell (sidebar nav + page scaffold + common blocks)
   Pairs with design tokens above.
   ============================================================ */

.app { display: grid; grid-template-columns: 232px 1fr; min-height: 100vh; }

/* ---------- sidebar ---------- */
.side {
  --side-bg: #1C1D1F;
  --side-fg: #9A9B9D;
  --side-fg-strong: #F4F2EC;
  --side-wm: #F2EFE7;
  --side-tag: #6E6F71;
  --side-line: rgba(255,255,255,0.08);
  --side-hover-bg: rgba(255,255,255,0.03);
  --side-active-bg: rgba(255,255,255,0.05);
  --side-accent: var(--gold-bright);
  background: var(--side-bg); color: var(--side-fg); display: flex; flex-direction: column;
  position: sticky; top: 0; height: 100vh; border-right: 1px solid var(--side-line);
}
.side .brand { padding: 22px 24px 22px; border-bottom: 1px solid var(--side-line); }
.side .brand .wm { font-family: var(--serif); font-weight: 500; font-size: 25px; letter-spacing: 0.06em; color: var(--side-wm); }
.side .brand .wm .g { color: var(--side-accent); }
.side .brand .tag { display: block; font-size: 9.5px; letter-spacing: 0.34em; color: var(--side-tag); margin-top: 7px; }

.side nav { padding: 14px 0; flex: 1; }
.navitem {
  display: flex; align-items: center; gap: 13px; padding: 11px 24px;
  font-size: 14px; color: var(--side-fg); text-decoration: none; font-weight: 400;
  border-left: 2px solid transparent;
}
.navitem .ic { display: none; }
.navitem:hover { color: var(--side-fg-strong); background: var(--side-hover-bg); }
.navitem.active { color: var(--side-fg-strong); background: var(--side-active-bg); border-left-color: var(--side-accent); }

.side .foot { padding: 18px 24px; border-top: 1px solid var(--side-line); font-size: 12px; color: var(--side-tag); }

/* ---------- main scaffold ---------- */
.main { padding: 44px 52px 68px; max-width: 1180px; }
.crumb { font-size: 11.5px; letter-spacing: 0.2em; color: var(--ink-faint); font-weight: 500; }
.pagehead { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin: 12px 0 26px; }
.pagehead > :first-child { flex: 1 1 auto; min-width: 0; }
.pagehead > a, .pagehead > .btn { flex: 0 0 auto; }
.pagehead h1 { font-family: var(--serif); font-weight: 500; font-size: 31px; line-height: 1.2; margin: 0 0 6px; letter-spacing: -0.02em; }
.pagehead .desc { font-size: 13.5px; color: var(--ink-faint); }
.rule { height: 1px; background: var(--line); margin-bottom: 28px; }

/* ---------- common: KPI strip ---------- */
.kpis { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line); background: transparent; }
.kpi { padding: 26px 28px 28px 0; border-right: none; }
.kpi:last-child { border-right: none; }
.kpi .label { font-size: 12px; color: var(--ink-faint); font-weight: 500; margin-bottom: 12px; }
.kpi .v { font-family: var(--serif); font-weight: 500; font-size: 34px; line-height: 1; letter-spacing: -0.02em; }
.kpi .v .u { font-size: 17px; margin-left: 1px; }
.kpi .foot { font-size: 12px; color: var(--ink-faint); margin-top: 11px; }
.v.pos { color: var(--green-ink); }
.v.neg { color: var(--red); }
.v.ink { color: var(--ink); }

/* ---------- common: card ---------- */
.block { margin-top: 30px; }
.card-kyn { border: 1px solid var(--line); background: transparent; }
.card-head { display: flex; align-items: center; justify-content: space-between; padding: 18px 24px 16px; }
.card-head .t { font-size: 15px; font-weight: 600; }
.card-head .t .sub { display: block; font-size: 12.5px; color: var(--ink-faint); font-weight: 400; margin-top: 4px; }
.link { font-size: 12.5px; color: var(--gold-deep); text-decoration: none; font-weight: 500; }
.link:hover { color: var(--gold); }

/* ---------- common: mini stat row ---------- */
.mini { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
.mini > div { padding: 16px 24px; border-right: 1px solid var(--line); }
.mini > div:last-child { border-right: none; }
.mini .l { font-size: 11.5px; color: var(--ink-faint); margin-bottom: 7px; }
.mini .n { font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }

.planlist {
  display: flex;
  flex-direction: column;
  border-top: 1px solid var(--line);
}

.prow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 12px 24px;
  border-bottom: 1px solid var(--line);
}

.prow:last-child { border-bottom: none; }

.prow .pl-name {
  min-width: 0;
  color: var(--ink-soft);
  font-size: 13.5px;
  line-height: 1.5;
}

.prow .pl-name b {
  color: var(--ink);
  font-weight: 600;
}

.prow .pl-name .arr {
  margin: 0 7px;
  color: var(--ink-faint);
}

.prow .pl-meta {
  flex: 0 0 auto;
  color: var(--ink-faint);
  font-size: 12.5px;
  line-height: 1.5;
  text-align: right;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.prow.more {
  justify-content: flex-start;
  color: var(--ink-faint);
  font-size: 12.5px;
}

/* ---------- common: section label inside main ---------- */
.lead { font-size: 14px; color: var(--ink-soft); line-height: 1.75; max-width: 64ch; }

/* ---------- common: two / three column grids ---------- */
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 22px; }
.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 22px; }

/* ---------- common: person card ---------- */
.person { border: 1px solid var(--line); background: transparent; padding: 24px 26px; display: flex; flex-direction: column; gap: 0; }
.person .top { display: flex; align-items: center; gap: 14px; }
.person .ava {
  width: 44px; height: 44px; flex: none; display: grid; place-items: center;
  font-family: var(--serif); font-size: 19px; color: #F2EFE7; background: #2A2B2D; letter-spacing: 0.02em;
}
.person .ava.gen1 { background: #2A2B2D; }
.person .ava.gen2 { background: var(--gold-deep); }
.person .ava.none { background: var(--paper-sink); color: var(--ink-faint); border: 1px dashed var(--line-strong); }
.person .nm { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }
.person .role { font-size: 12px; color: var(--ink-faint); margin-top: 3px; }
.person .meta { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 9px; }
.person .meta .r { display: flex; justify-content: space-between; align-items: baseline; font-size: 13px; }
.person .meta .r .k { color: var(--ink-faint); }
.person .meta .r .val { font-weight: 600; letter-spacing: -0.01em; }

/* ---------- common: pill tag ---------- */
.pill {
  display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 500;
  padding: 4px 9px; border: 1px solid var(--line-strong); color: var(--ink-soft); letter-spacing: 0.01em;
}
.pill.gold { color: var(--gold-deep); border-color: rgba(154,123,46,0.4); background: var(--gold-tint); }
.pill.none { color: var(--ink-faint); border-style: dashed; }

/* ---------- common: progress bar ---------- */
.bar { height: 6px; background: var(--paper-sink); position: relative; }
.bar > span { position: absolute; inset: 0 auto 0 0; background: var(--gold); }
.bar > span.pine { background: var(--green); }
.bar > span.brass { background: var(--gold); }
.bar > span.clay { background: var(--red); }

/* ---------- common: definition list ---------- */
.deflist { display: flex; flex-direction: column; }
.deflist .d { display: flex; justify-content: space-between; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
.deflist .d:last-child { border-bottom: none; }
.deflist .d .k { color: var(--ink-soft); }
.deflist .d .k small { display: block; color: var(--ink-faint); font-size: 11.5px; margin-top: 3px; font-weight: 400; }
.deflist .d .v { font-weight: 600; letter-spacing: -0.01em; }
.deflist .d.total { border-top: 1px solid var(--line-strong); border-bottom: none; padding-top: 16px; }
.deflist .d.total .k, .deflist .d.total .v { font-weight: 700; }
.deflist .d .v.neg { color: var(--red); }
.deflist .d .v.pos { color: var(--green-ink); }

/* ---------- common: status summary strip ---------- */
.summary { display: flex; gap: 0; border: none; border-top: 1px solid var(--line); background: transparent; margin-top: 32px; }
.summary .s { flex: 1; padding: 18px 22px 18px 0; border-right: none; display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--ink-soft); }
.summary .s:last-child { border-right: none; }
.summary .s .dot { width: 6px; height: 6px; flex: none; }
.summary .s.ok .dot { background: var(--green); }
.summary .s.warn .dot { background: var(--red); }
.summary .s.note .dot { background: var(--gold); }
.summary .s b { color: var(--ink); font-weight: 600; }

/* ---------- responsive: sidebar → top strip ---------- */
@media (max-width: 900px) {
  .app { grid-template-columns: 1fr; }
  .side { position: static; height: auto; flex-direction: row; align-items: center; overflow-x: auto; }
  .side .brand { border-bottom: none; border-right: 1px solid rgba(255,255,255,0.08); white-space: nowrap; }
  .side nav { display: flex; padding: 0; }
  .side .foot { display: none; }
  .navitem { white-space: nowrap; border-left: none; border-bottom: 2px solid transparent; }
  .navitem.active { border-left: none; border-bottom-color: var(--gold-bright); }
  .main { padding: 28px 22px 48px; }
  .kpis { grid-template-columns: 1fr 1fr; }
  .kpi:nth-child(2) { border-right: none; }
  .kpi:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  .mini { grid-template-columns: 1fr 1fr; }
  .grid3 { grid-template-columns: 1fr; }
  .grid2 { grid-template-columns: 1fr; }
  .summary { flex-direction: column; }
  .summary .s { border-right: none; border-bottom: 1px solid var(--line); }
}
@media (max-width: 600px) {
  .pagehead { flex-direction: column; align-items: flex-start; gap: 16px; }
}

/* ============================================================
   KYN — Shared component tokens (from kyn.css)
   ============================================================ */

/* ---------- Eyebrow / small label ---------- */
.eyebrow {
  font-size: 12px; letter-spacing: 0.22em; font-weight: 500;
  color: var(--gold-deep); text-transform: none;
  display: inline-flex; align-items: center; gap: 10px;
}
.eyebrow::before {
  content: ""; width: 22px; height: 1px; background: var(--gold);
  display: inline-block;
}

/* ---------- Numbers ---------- */
.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  letter-spacing: -0.02em;
}

/* ---------- Status badges ---------- */
.badge {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 12.5px; font-weight: 500; line-height: 1;
  padding: 6px 11px 6px 9px; border: 1px solid var(--line-strong);
  white-space: nowrap;
}
.badge .dot { width: 7px; height: 7px; flex: none; }
.badge.is-go     { color: var(--green-ink); border-color: rgba(44,64,52,0.3); background: var(--green-tint); }
.badge.is-go     .dot { background: var(--green); }
.badge.is-watch  { color: var(--amber); border-color: rgba(138,100,32,0.32); background: var(--amber-tint); }
.badge.is-watch  .dot { background: var(--amber); }
.badge.is-stop   { color: var(--red); border-color: rgba(140,58,44,0.32); background: var(--red-tint); }
.badge.is-stop   .dot { background: var(--red); }

/* ---------- Callouts ---------- */
.callout {
  border-left: 2px solid var(--line-strong);
  padding: 14px 18px; background: var(--paper);
  font-size: 14px; color: var(--ink-soft); line-height: 1.6;
}
.callout strong { color: var(--ink); font-weight: 600; }
.callout.is-warn  { border-left-color: var(--amber); background: var(--amber-tint); }
.callout.is-danger{ border-left-color: var(--red);   background: var(--red-tint); }
.callout.is-legal {
  border-left-color: var(--legal); background: var(--legal-tint);
  color: var(--legal); font-size: 13px;
}
.callout.is-legal strong { color: var(--legal); }

/* ---------- Tabs ---------- */
.tabs { display: flex; gap: 28px; border-bottom: 1px solid var(--line); }
.tab {
  font-size: 14.5px; font-weight: 500; color: var(--ink-faint);
  padding: 0 1px 14px; cursor: pointer; background: none; border: none;
  border-bottom: 2px solid transparent; margin-bottom: -1px; font-family: var(--sans);
}
.tab.active { color: var(--ink); border-bottom-color: var(--gold); }
.tab:hover:not(.active) { color: var(--ink-soft); }

/* ---------- Section heading ---------- */
.sec-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; }
.sec-title { font-family: var(--serif); font-weight: 500; font-size: 21px; letter-spacing: -0.01em; }
.sec-note { font-size: 12.5px; color: var(--ink-faint); }

/* ---------- Tables ---------- */
.table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
.table th, .table td { text-align: left; padding: 15px 16px; border-bottom: 1px solid var(--line); }
.table thead th {
  font-size: 12px; font-weight: 500; color: var(--ink-faint);
  letter-spacing: 0.02em; border-bottom: 1px solid var(--line-strong);
}
.table td.r, .table th.r { text-align: right; }
.table .num { font-weight: 600; }

/* ---------- Utility ---------- */
.muted { color: var(--ink-faint); }
.soft  { color: var(--ink-soft); }
.serif { font-family: var(--serif); }

/* ============================================================
   KYN dashboard top navigation
   The supplied dashboard reference uses a quiet editorial shell.
   Existing feature pages inherit the same visual language here.
   ============================================================ */
.kyn-dashboard-shell {
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}

.kyn-topbar {
  position: sticky;
  top: 0;
  z-index: 40;
  border-bottom: 1px solid var(--line);
  background: var(--bg);
}

.kyn-topbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 34px;
  padding: 20px 40px;
}

.kyn-topnav {
  display: flex;
  min-width: 0;
  flex: 1;
  align-self: stretch;
  align-items: center;
  gap: 28px;
  overflow-x: auto;
  scrollbar-width: none;
}

.kyn-topnav::-webkit-scrollbar { display: none; }

.kyn-topnav a {
  display: flex;
  height: 100%;
  flex: none;
  align-items: center;
  border-bottom: 2px solid transparent;
  color: var(--ink-faint);
  font-size: 13px;
  font-weight: 500;
  text-decoration: none;
  transition: color 0.16s ease, border-color 0.16s ease;
  white-space: nowrap;
}

.kyn-topnav a:hover { color: var(--ink-soft); }
.kyn-topnav a.active {
  border-bottom-color: var(--gold);
  color: var(--ink);
}

.kyn-topbar-actions {
  display: flex;
  flex: none;
  align-items: center;
  gap: 14px;
}

.kyn-invite-code,
.kyn-logout {
  border: 0;
  background: transparent;
  color: var(--ink-faint);
  cursor: pointer;
  font-family: inherit;
}

.kyn-invite-code {
  display: flex;
  align-items: baseline;
  gap: 7px;
  border-left: 1px solid var(--line);
  padding-left: 16px;
  font-size: 10px;
  letter-spacing: 0.08em;
}

.kyn-invite-code strong {
  color: var(--gold-deep);
  font-family: monospace;
  font-size: 11px;
  letter-spacing: 0.12em;
}

.kyn-logout {
  padding: 8px 0;
  font-size: 12px;
  font-weight: 500;
}

.kyn-invite-code:hover,
.kyn-logout:hover { color: var(--ink); }

.kyn-dashboard-content {
  min-height: calc(100vh - 81px);
  background: var(--bg);
}

.kyn-dashboard-content > * {
  width: 100%;
  margin-right: auto;
  margin-left: auto;
}

.kyn-dashboard-content > .p-6,
.kyn-dashboard-content > .p-8 {
  max-width: var(--maxw) !important;
  padding: 44px 40px 80px !important;
  background: var(--bg) !important;
}

.kyn-dashboard-content .main {
  width: 100%;
  max-width: var(--maxw) !important;
  margin-right: auto;
  margin-left: auto;
}

.kyn-dashboard-content .max-w-2xl,
.kyn-dashboard-content .max-w-5xl,
.kyn-dashboard-content .max-w-screen-xl {
  max-width: var(--maxw) !important;
}

/* Compatibility layer for feature-rich screens added after the mockups. */
.kyn-dashboard-content .page-header {
  border-color: var(--line);
  margin-bottom: 28px;
  padding-bottom: 20px;
}

.kyn-dashboard-content .page-title {
  color: var(--ink);
  font-family: var(--serif);
  font-size: 30px;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.kyn-dashboard-content .page-sub,
.kyn-dashboard-content .section-label {
  color: var(--ink-faint);
}

.kyn-dashboard-content .section-label {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.2em;
}

.kyn-dashboard-content .shadow,
.kyn-dashboard-content .shadow-sm,
.kyn-dashboard-content .shadow-md,
.kyn-dashboard-content .shadow-lg {
  box-shadow: none !important;
}

.kyn-dashboard-content .card,
.kyn-dashboard-content .metric-card,
.kyn-dashboard-content .bg-white {
  box-shadow: none !important;
}

.kyn-dashboard-content .card {
  border-color: var(--line) !important;
  background: transparent !important;
}

.kyn-dashboard-content .metric-card {
  border-color: var(--line) !important;
  background: var(--paper) !important;
}

.kyn-dashboard-content .bg-gray-50,
.kyn-dashboard-content .bg-stone-50 {
  background-color: var(--paper) !important;
}

.kyn-dashboard-content .bg-gray-100,
.kyn-dashboard-content .bg-stone-100 {
  background-color: var(--paper-sink) !important;
}

.kyn-dashboard-content .border-gray-100,
.kyn-dashboard-content .border-gray-200,
.kyn-dashboard-content .border-gray-300,
.kyn-dashboard-content .border-stone-100,
.kyn-dashboard-content .border-stone-200,
.kyn-dashboard-content .border-stone-300 {
  border-color: var(--line) !important;
}

.kyn-dashboard-content .text-gray-300,
.kyn-dashboard-content .text-gray-400,
.kyn-dashboard-content .text-gray-500,
.kyn-dashboard-content .text-stone-400,
.kyn-dashboard-content .text-stone-500 {
  color: var(--ink-faint) !important;
}

.kyn-dashboard-content .text-gray-600,
.kyn-dashboard-content .text-gray-700,
.kyn-dashboard-content .text-gray-800,
.kyn-dashboard-content .text-gray-900,
.kyn-dashboard-content .text-stone-600,
.kyn-dashboard-content .text-stone-700,
.kyn-dashboard-content .text-stone-800,
.kyn-dashboard-content .text-stone-900 {
  color: var(--ink-soft) !important;
}

.kyn-dashboard-content .bg-blue-600,
.kyn-dashboard-content .bg-indigo-500,
.kyn-dashboard-content .bg-purple-500,
.kyn-dashboard-content .bg-teal-500,
.kyn-dashboard-content .bg-teal-600 {
  background-color: var(--ink) !important;
}

.kyn-dashboard-content .border-blue-300,
.kyn-dashboard-content .border-blue-400,
.kyn-dashboard-content .border-blue-500,
.kyn-dashboard-content .border-purple-300,
.kyn-dashboard-content .border-teal-300 {
  border-color: var(--gold) !important;
}

.kyn-dashboard-content .text-indigo-600,
.kyn-dashboard-content .text-purple-600,
.kyn-dashboard-content .text-teal-600,
.kyn-dashboard-content .text-teal-700 {
  color: var(--gold-deep) !important;
}

.kyn-dashboard-content .bg-indigo-50,
.kyn-dashboard-content .bg-purple-50,
.kyn-dashboard-content .bg-teal-50 {
  background-color: var(--gold-tint) !important;
}

.tax-page .tabs {
  background: transparent;
}

.tax-page .tab {
  flex: 1;
}

.tax-total-band {
  background: var(--ink) !important;
  color: #F4F2EC !important;
  border-color: var(--ink) !important;
}

.scenario-modebar {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  border: 1px solid var(--line);
  background: var(--paper);
}

.scenario-mode {
  min-height: 42px;
  padding: 0 16px;
  border: 0;
  border-right: 1px solid var(--line);
  background: transparent;
  color: var(--ink-soft);
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.16s ease, color 0.16s ease;
}

.scenario-mode:hover {
  color: var(--ink);
  background: var(--paper-sink);
}

.scenario-mode.active {
  background: var(--ink);
  color: #F4F2EC;
}

.scenario-search-btn {
  min-height: 42px;
  margin-left: auto;
  padding: 0 16px;
  border: 0;
  border-left: 1px solid var(--line);
  background: var(--gold-tint);
  color: var(--gold-deep);
  font-size: 12.5px;
  font-weight: 700;
  cursor: pointer;
}

.scenario-search-btn:hover {
  background: rgba(154,123,46,0.16);
}

.scenario-search-result {
  border: 1px solid var(--gold);
  background: #fff;
  box-shadow: none;
}

.optimal-panel {
  color: var(--ink);
}

.optimal-control-bar,
.optimal-card,
.optimal-action-card {
  background: #fff;
  border: 1px solid var(--line);
}

.optimal-control-bar {
  padding: 12px 16px;
  background: var(--paper);
}

.optimal-control-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--ink);
}

.optimal-control-note {
  font-size: 11px;
  color: var(--ink-muted);
}

.optimal-cash-input {
  width: 72px;
  border: 1px solid var(--line-strong);
  padding: 4px 9px;
  font-size: 13px;
  font-weight: 700;
  background: #fff;
  outline: none;
}

.optimal-inline-link {
  border: 0;
  background: none;
  color: var(--gold-deep);
  cursor: pointer;
  font-size: 11px;
  font-weight: 600;
  text-decoration: underline;
}

.optimal-diagnosis-hero {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  align-items: stretch;
  border: 1px solid #D8C899;
  border-left: 3px solid var(--gold);
  background: linear-gradient(180deg, #FFFDF7 0%, #FAF7EE 100%);
  padding: 18px 20px;
}

.optimal-eyebrow {
  margin-bottom: 6px;
  color: #9A7627;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.optimal-hero-title {
  margin-bottom: 4px;
  color: #26211A;
  font-family: var(--sans);
  font-size: 21px;
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: 1.35;
}

.optimal-hero-sub {
  color: #6F6A62;
  font-size: 12px;
  line-height: 1.5;
}

.optimal-hero-sub strong {
  color: #9A7627;
}

.optimal-hero-metrics {
  display: grid;
  min-width: 260px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  background: #E3D8BC;
  border: 1px solid #D8C899;
}

.optimal-hero-metric {
  min-width: 120px;
  background: rgba(255,255,255,0.72);
  padding: 12px 14px;
  text-align: center;
}

.optimal-hero-metric > div {
  margin-bottom: 4px;
  color: #8A8175;
  font-size: 9px;
}

.optimal-hero-metric strong {
  font-size: 14px;
}

.optimal-hero-metric strong.is-ok { color: #0E8F61; }
.optimal-hero-metric strong.is-risk { color: #B94A35; }

.optimal-card-head {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: baseline;
  border-bottom: 1px solid var(--line);
  padding: 12px 16px;
}

.optimal-card-head span {
  font-size: 13px;
  font-weight: 700;
}

.optimal-card-head small {
  color: var(--ink-muted);
  font-size: 10px;
}

.optimal-sensitivity-grid {
  display: grid;
}

.optimal-sensitivity-cell {
  border-right: 1px solid var(--line);
  padding: 12px 14px;
  background: #fff;
}

.optimal-sensitivity-cell:last-child {
  border-right: 0;
}

.optimal-sensitivity-cell.active {
  background: var(--gold-tint);
}

.optimal-sensitivity-title {
  margin-bottom: 7px;
  color: var(--ink-muted);
  font-size: 10px;
  font-weight: 700;
}

.optimal-sensitivity-cell.active .optimal-sensitivity-title {
  color: var(--gold-deep);
}

.optimal-kv {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 4px;
  color: var(--ink-soft);
  font-size: 11px;
}

.optimal-kv:last-child {
  margin-bottom: 0;
}

.optimal-kv strong {
  color: var(--ink);
  font-weight: 700;
  white-space: nowrap;
}

.optimal-action-card.ready {
  border-color: rgba(47, 111, 78, 0.55);
}

.optimal-action-card.conditional {
  border-color: var(--gold);
}

.optimal-action-head {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  align-items: flex-start;
  border-bottom: 1px solid var(--line);
  padding: 16px 18px;
}

.optimal-action-label {
  margin-bottom: 5px;
  color: var(--gold-deep);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.optimal-action-title {
  margin-bottom: 5px;
  color: var(--ink);
  font-size: 17px;
  font-weight: 800;
}

.optimal-action-copy {
  color: var(--ink-soft);
  font-size: 11px;
  line-height: 1.65;
}

.optimal-number-box {
  min-width: 230px;
  border: 1px solid rgba(154,123,46,0.30);
  background: var(--gold-tint);
  padding: 10px 13px;
}

.optimal-number-caption {
  margin-bottom: 6px;
  color: var(--ink-muted);
  font-size: 9px;
  font-weight: 700;
}

.kyn-loader-screen {
  min-height: 420px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 18px;
  background: #fff;
}

.kyn-loader-ring {
  width: 34px;
  height: 34px;
  border: 3px solid rgba(154,123,46,0.16);
  border-top-color: var(--gold);
  border-right-color: var(--gold);
  border-radius: 9999px !important;
  animation: kyn-loader-spin 0.9s linear infinite;
}

.kyn-loader-label {
  color: var(--ink-faint);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.34em;
}

@keyframes kyn-loader-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 768px) {
  .optimal-hero-title { font-size: 20px; }
  .optimal-hero-metrics,
  .optimal-sensitivity-grid {
    grid-template-columns: 1fr !important;
  }
  .optimal-sensitivity-cell {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }
}

.kyn-dashboard-content input[type="range"] {
  accent-color: var(--gold);
}

.kyn-dashboard-content input,
.kyn-dashboard-content select,
.kyn-dashboard-content textarea {
  border-color: var(--line-strong);
  background-color: #fff;
  color: var(--ink);
}

.kyn-dashboard-content input:focus,
.kyn-dashboard-content select:focus,
.kyn-dashboard-content textarea:focus {
  border-color: var(--gold);
  outline-color: rgba(154,123,46,0.24);
}

.kyn-dashboard-content .bg-blue-50 { background-color: rgba(63,77,102,0.055) !important; }
.kyn-dashboard-content .border-blue-100,
.kyn-dashboard-content .border-blue-200 { border-color: rgba(63,77,102,0.18) !important; }
.kyn-dashboard-content .text-blue-700,
.kyn-dashboard-content .text-blue-800,
.kyn-dashboard-content .text-blue-900,
.kyn-dashboard-content .text-blue-950 { color: var(--legal) !important; }

.kyn-dashboard-content .bg-emerald-50,
.kyn-dashboard-content .bg-green-50 { background-color: var(--green-tint) !important; }
.kyn-dashboard-content .border-emerald-100,
.kyn-dashboard-content .border-emerald-200,
.kyn-dashboard-content .border-green-100,
.kyn-dashboard-content .border-green-200 { border-color: rgba(44,64,52,0.22) !important; }
.kyn-dashboard-content .text-emerald-700,
.kyn-dashboard-content .text-emerald-800,
.kyn-dashboard-content .text-green-600,
.kyn-dashboard-content .text-green-700,
.kyn-dashboard-content .text-green-800 { color: var(--green-ink) !important; }

.kyn-dashboard-content .bg-amber-50,
.kyn-dashboard-content .bg-orange-50,
.kyn-dashboard-content .bg-yellow-50 { background-color: var(--amber-tint) !important; }
.kyn-dashboard-content .border-amber-100,
.kyn-dashboard-content .border-amber-200,
.kyn-dashboard-content .border-orange-200,
.kyn-dashboard-content .border-yellow-200 { border-color: rgba(138,100,32,0.22) !important; }
.kyn-dashboard-content .text-amber-700,
.kyn-dashboard-content .text-amber-800,
.kyn-dashboard-content .text-amber-900,
.kyn-dashboard-content .text-orange-500,
.kyn-dashboard-content .text-orange-600,
.kyn-dashboard-content .text-orange-700,
.kyn-dashboard-content .text-orange-800 { color: var(--amber) !important; }

.kyn-dashboard-content .bg-red-50 { background-color: var(--red-tint) !important; }
.kyn-dashboard-content .border-red-100,
.kyn-dashboard-content .border-red-200 { border-color: rgba(140,58,44,0.22) !important; }
.kyn-dashboard-content .text-red-600,
.kyn-dashboard-content .text-red-700,
.kyn-dashboard-content .text-red-800 { color: var(--red) !important; }

@media (max-width: 1120px) {
  .kyn-topbar-row { gap: 22px; padding: 0 24px; }
  .kyn-topnav { gap: 20px; }
  .kyn-invite-code { display: none; }
}

@media (max-width: 720px) {
  .kyn-topbar-row {
    min-height: auto;
    flex-wrap: wrap;
    gap: 0;
    padding: 14px 18px 0;
  }
  .kyn-wordmark { font-size: 21px; }
  .kyn-topbar-actions { margin-left: auto; }
  .kyn-topnav {
    order: 3;
    width: calc(100% + 36px);
    flex-basis: calc(100% + 36px);
    gap: 20px;
    margin: 10px -18px 0;
    padding: 0 18px;
  }
  .kyn-topnav a {
    height: 42px;
    font-size: 12px;
  }
  .kyn-dashboard-content { min-height: calc(100vh - 118px); }
  .kyn-dashboard-content .main { padding: 28px 22px 48px; }
  .kyn-dashboard-content > .p-6 { padding: 28px 22px 48px; }
}

/* ── Strategy Analysis — Claude Design handoff, scoped ───────── */
.kyn-strategy {
  width: 100%;
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 44px 40px 80px;
  color: var(--ink);
  font-family: var(--sans);
}

.kyn-strategy .num {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

.kyn-strategy .crumb {
  font-size: 12px;
  letter-spacing: 0.22em;
  color: var(--gold-deep);
  font-weight: 500;
  text-transform: uppercase;
}

.kyn-strategy .pagehead {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-top: 14px;
}

.kyn-strategy .pagehead h1 {
  margin: 0;
  font-family: var(--serif);
  font-size: 31px;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.kyn-strategy .pagehead .desc {
  margin-top: 8px;
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--ink-faint);
}

.kyn-strategy .rule {
  height: 1px;
  margin: 22px 0 26px;
  background: var(--line);
}

.kyn-strategy .block { margin-bottom: 18px; }
.kyn-strategy .card { border: 1px solid var(--line); background: transparent; }

.kyn-strategy .card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 24px;
  border-bottom: 1px solid var(--line);
}

.kyn-strategy .card-head .t {
  font-size: 15px;
  font-weight: 600;
}

.kyn-strategy .card-head .t .sub {
  display: block;
  margin-top: 4px;
  font-size: 12.5px;
  line-height: 1.55;
  color: var(--ink-faint);
  font-weight: 400;
}

.kyn-strategy .link {
  border: 0;
  background: none;
  color: var(--gold-deep);
  cursor: pointer;
  font-family: inherit;
  font-size: 12.5px;
  font-weight: 500;
  text-decoration: none;
}

.kyn-strategy .link:hover { color: var(--gold); }

.kyn-strategy .stepbar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20px;
  border: 1px solid var(--line);
  border-left: 2px solid var(--gold);
  background: var(--paper);
  padding: 16px 22px;
}

.kyn-strategy .stepbar b {
  font-size: 14px;
  font-weight: 600;
}

.kyn-strategy .stepbar span {
  margin-left: 8px;
  font-size: 13px;
  line-height: 1.65;
  color: var(--ink-faint);
}

.kyn-strategy .mini {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.kyn-strategy .mini > div {
  padding: 18px 24px;
  border-right: 1px solid var(--line);
}

.kyn-strategy .mini > div:last-child { border-right: none; }
.kyn-strategy .mini .l { margin-bottom: 9px; font-size: 12px; color: var(--ink-faint); }
.kyn-strategy .mini .n {
  font-family: var(--serif);
  font-size: 26px;
  font-weight: 500;
  letter-spacing: -0.02em;
}

.kyn-strategy .planlist {
  display: flex;
  flex-direction: column;
  border-top: 1px solid var(--line);
}

.kyn-strategy .prow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 14px 24px;
  border-bottom: 1px solid var(--line);
}

.kyn-strategy .prow:last-child { border-bottom: none; }
.kyn-strategy .prow .pl-name { font-size: 14px; color: var(--ink-soft); }
.kyn-strategy .prow .pl-name b { color: var(--ink); font-weight: 600; }
.kyn-strategy .prow .pl-name .arr { margin: 0 7px; color: var(--ink-faint); }
.kyn-strategy .prow .pl-meta {
  white-space: nowrap;
  color: var(--ink-faint);
  font-size: 12.5px;
  font-variant-numeric: tabular-nums;
}
.kyn-strategy .prow.more {
  justify-content: flex-start;
  color: var(--ink-faint);
  font-size: 12.5px;
}

.kyn-strategy .setbody {
  display: flex;
  flex-direction: column;
  gap: 22px;
  padding: 22px 24px 26px;
}

.kyn-strategy .fgrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
}

.kyn-strategy .flab {
  margin-bottom: 9px;
  color: var(--ink-soft);
  font-size: 12.5px;
  font-weight: 600;
}

.kyn-strategy select.kyn,
.kyn-strategy input.kyn {
  width: 100%;
  border: 1px solid var(--line-strong);
  background: var(--bg);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 14px;
  font-variant-numeric: tabular-nums;
  padding: 11px 14px;
}

.kyn-strategy select.kyn {
  appearance: none;
  cursor: pointer;
  padding-right: 34px;
  background-image:
    linear-gradient(45deg, transparent 50%, var(--ink-faint) 50%),
    linear-gradient(135deg, var(--ink-faint) 50%, transparent 50%);
  background-position: calc(100% - 19px) 18px, calc(100% - 13px) 18px;
  background-repeat: no-repeat;
  background-size: 6px 6px, 6px 6px;
}

.kyn-strategy input.kyn:focus,
.kyn-strategy select.kyn:focus {
  border-color: var(--gold);
  outline: none;
}

.kyn-strategy .checks {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
}

.kyn-strategy .chk {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--ink-soft);
  cursor: pointer;
  font-size: 13.5px;
}

.kyn-strategy .chk input {
  width: 15px;
  height: 15px;
  accent-color: var(--gold-deep);
}

.kyn-strategy .chk .muted { color: var(--ink-faint); }

.kyn-strategy .small-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.kyn-strategy .small-grid .sl {
  margin-bottom: 6px;
  color: var(--ink-faint);
  font-size: 12px;
}

.kyn-strategy .diag {
  margin-top: 24px;
  border: 1px solid var(--line-strong);
  background: var(--bg);
}

.kyn-strategy .diag .dtop {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-bottom: 1px solid var(--line);
}

.kyn-strategy .diag .dc {
  min-height: 174px;
  padding: 32px 36px;
  border-right: 1px solid var(--line);
}

.kyn-strategy .diag .dc:last-child { border-right: none; }
.kyn-strategy .diag .dl { margin-bottom: 14px; color: var(--ink-faint); font-size: 15px; }
.kyn-strategy .diag .dv {
  color: var(--ink);
  font-family: var(--serif);
  font-size: 44px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.03em;
}
.kyn-strategy .diag .dv .u {
  margin-left: 2px;
  color: var(--ink-faint);
  font-size: 18px;
}
.kyn-strategy .diag .dc.alert { background: var(--red-tint); }
.kyn-strategy .diag .dc.alert .dv { color: var(--red); }
.kyn-strategy .diag .dc.save { background: var(--green-tint); }
.kyn-strategy .diag .dc.save .dl,
.kyn-strategy .diag .dc.save .dv { color: var(--green-ink); }
.kyn-strategy .diag .dmeta {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 18px 36px;
  color: var(--ink-faint);
  font-size: 15px;
}
.kyn-strategy .diag .dmeta .sep { color: var(--line-strong); }

.kyn-strategy .badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--line-strong);
  color: var(--ink-soft);
  font-size: 13px;
  font-weight: 500;
  padding: 7px 14px;
}

.kyn-strategy .badge .dot {
  width: 9px;
  height: 9px;
  background: currentColor;
}

.kyn-strategy .badge.is-stop {
  border-color: rgba(140, 58, 44, 0.4);
  background: var(--red-tint);
  color: var(--red);
}

.kyn-strategy .qsec {
  border: 1px solid var(--line);
  background: var(--bg);
}

.kyn-strategy .qsec[data-open="true"] { border-color: var(--line-strong); }

.kyn-strategy .qhead {
  display: grid;
  grid-template-columns: 48px 1fr 22px;
  align-items: center;
  gap: 22px;
  width: 100%;
  border: 0;
  background: none;
  cursor: pointer;
  font-family: inherit;
  padding: 28px 30px;
  text-align: left;
}

.kyn-strategy .qhead .qn {
  align-self: start;
  color: var(--gold-deep);
  font-family: var(--serif);
  font-size: 15px;
  font-weight: 500;
}

.kyn-strategy .qhead h3 {
  margin: 0;
  color: var(--ink);
  font-family: var(--serif);
  font-size: 23px;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.kyn-strategy .qhead .qd {
  display: block;
  margin-top: 8px;
  color: var(--ink-faint);
  font-size: 14px;
  font-variant-numeric: tabular-nums;
}

.kyn-strategy .qhead .chev {
  width: 13px;
  height: 13px;
  justify-self: end;
  border-right: 1.5px solid var(--ink-faint);
  border-bottom: 1.5px solid var(--ink-faint);
  transform: rotate(45deg);
  transition: transform .2s ease;
}

.kyn-strategy .qsec[data-open="true"] .qhead .chev { transform: rotate(-135deg); }
.kyn-strategy .qbody { padding: 0 30px 30px 100px; }

.kyn-strategy .reducer {
  margin-bottom: 22px;
  border: 1px solid var(--line);
  border-left: 2px solid var(--gold);
  background: var(--paper);
  padding: 22px 24px;
}

.kyn-strategy .reducer .rh {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.kyn-strategy .reducer .rt {
  color: var(--ink);
  font-size: 14.5px;
  font-weight: 600;
}

.kyn-strategy .reducer .rd {
  max-width: 62ch;
  margin-top: 5px;
  color: var(--ink-faint);
  font-size: 12.5px;
  line-height: 1.6;
}

.kyn-strategy .reducer .rpct {
  min-width: 128px;
  border: 1px solid var(--line);
  background: var(--bg);
  padding: 14px 16px;
  text-align: right;
  white-space: nowrap;
}

.kyn-strategy .reducer .rpct .rl {
  color: var(--ink-faint);
  font-size: 11.5px;
}

.kyn-strategy .reducer .rpct .rv {
  margin-top: 4px;
  color: var(--gold-deep);
  font-family: var(--serif);
  font-size: 38px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.03em;
}

.kyn-strategy input[type="range"].slider {
  appearance: none;
  width: 100%;
  height: 3px;
  margin: 22px 0 16px;
  background: var(--line-strong);
  cursor: pointer;
}

.kyn-strategy input[type="range"].slider::-webkit-slider-thumb {
  appearance: none;
  width: 18px;
  height: 18px;
  border: 3px solid var(--bg);
  border-radius: 50% !important;
  background: var(--gold-deep);
  box-shadow: 0 0 0 1px var(--gold-deep);
}

.kyn-strategy input[type="range"].slider::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border: 3px solid var(--bg);
  border-radius: 50% !important;
  background: var(--gold-deep);
  box-shadow: 0 0 0 1px var(--gold-deep);
}

.kyn-strategy .presets { display: flex; flex-wrap: wrap; gap: 8px; }
.kyn-strategy .preset {
  border: 1px solid var(--line-strong);
  background: var(--bg);
  color: var(--ink-soft);
  cursor: pointer;
  font-family: var(--sans);
  font-size: 12.5px;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  padding: 7px 14px;
}
.kyn-strategy .preset[aria-pressed="true"] {
  border-color: var(--ink);
  background: var(--ink);
  color: #F2EFE7;
}

.kyn-strategy .rmini {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  border: 1px solid var(--line);
  border-top: 0;
}

.kyn-strategy .rmini .rc {
  padding: 15px 16px;
  border-right: 1px solid var(--line);
}
.kyn-strategy .rmini .rc:last-child { border-right: none; }
.kyn-strategy .rmini .rcl {
  margin-bottom: 7px;
  color: var(--ink-faint);
  font-size: 11px;
  line-height: 1.3;
}
.kyn-strategy .rmini .rcv {
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}
.kyn-strategy .rmini .rcv.warn { color: var(--amber); }
.kyn-strategy .rnote {
  margin-top: 12px;
  color: var(--ink-faint);
  font-size: 11.5px;
  line-height: 1.6;
}

.kyn-strategy .ttabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin-top: 24px;
  border: 1px solid var(--line-strong);
}

.kyn-strategy .ttab {
  border: 0;
  border-right: 1px solid var(--line);
  background: var(--paper);
  color: var(--ink-faint);
  cursor: pointer;
  font-family: inherit;
  font-size: 13.5px;
  font-weight: 500;
  padding: 14px;
  text-align: center;
}

.kyn-strategy .ttab:last-child { border-right: none; }
.kyn-strategy .ttab[aria-selected="true"] { background: var(--ink); color: #F2EFE7; }
.kyn-strategy .strats {
  border: 1px solid var(--line-strong);
  border-top: none;
}

.kyn-strategy .strat {
  display: grid;
  grid-template-columns: 22px 1fr auto;
  align-items: center;
  gap: 16px;
  border-bottom: 1px solid var(--line);
  cursor: pointer;
  padding: 18px 22px;
}

.kyn-strategy .strat:last-child { border-bottom: none; }
.kyn-strategy .strat[data-selected="true"] { background: var(--gold-tint); }
.kyn-strategy .strat[data-disabled="true"] { opacity: 0.55; }
.kyn-strategy .strat input {
  width: 16px;
  height: 16px;
  accent-color: var(--gold-deep);
}
.kyn-strategy .strat button {
  border: 0;
  background: none;
  color: inherit;
  cursor: pointer;
  font-family: inherit;
  padding: 0;
}
.kyn-strategy .strat .stags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 6px;
}
.kyn-strategy .strat .timing {
  border: 1px solid rgba(154, 123, 46, 0.4);
  background: var(--gold-tint);
  color: var(--gold-deep);
  font-size: 11px;
  font-weight: 500;
  padding: 3px 8px;
}
.kyn-strategy .strat .diff {
  font-size: 11.5px;
  font-weight: 500;
}
.kyn-strategy .strat .diff.easy { color: var(--green-ink); }
.kyn-strategy .strat .diff.mid { color: var(--amber); }
.kyn-strategy .strat .diff.hard { color: var(--ink-faint); }
.kyn-strategy .strat .stitle {
  color: var(--ink);
  font-size: 14.5px;
  font-weight: 600;
}
.kyn-strategy .strat .slaw {
  margin-top: 4px;
  color: var(--ink-faint);
  font-size: 12px;
}
.kyn-strategy .strat .simp {
  text-align: right;
  white-space: nowrap;
}
.kyn-strategy .strat .simp .il {
  color: var(--ink-faint);
  font-size: 11px;
}
.kyn-strategy .strat .simp .iv {
  margin-top: 2px;
  color: var(--green-ink);
  font-family: var(--serif);
  font-size: 19px;
  font-weight: 500;
  letter-spacing: -0.01em;
}
.kyn-strategy .strat .simp .iv.muted {
  color: var(--ink-faint);
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 500;
}

.kyn-strategy .stratfoot {
  border: 1px solid var(--line-strong);
  border-top: none;
  background: var(--paper);
  color: var(--ink-faint);
  font-size: 13px;
  padding: 16px 22px;
}

.kyn-strategy .stratfoot strong { color: var(--ink); font-weight: 600; }

@media (max-width: 860px) {
  .kyn-strategy { padding: 28px 20px 56px; }
  .kyn-strategy .mini {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .kyn-strategy .mini > div {
    border-bottom: 1px solid var(--line);
  }
  .kyn-strategy .mini > div:nth-child(2n) {
    border-right: none;
  }
  .kyn-strategy .mini > div:nth-last-child(-n + 2) {
    border-bottom: none;
  }
  .kyn-strategy .fgrid,
  .kyn-strategy .small-grid,
  .kyn-strategy .rmini { grid-template-columns: 1fr; }
  .kyn-strategy .diag .dtop { grid-template-columns: 1fr 1fr; }
  .kyn-strategy .diag .dc {
    min-height: auto;
    padding: 24px;
    border-bottom: 1px solid var(--line);
  }
  .kyn-strategy .diag .dc:nth-child(2n) { border-right: none; }
  .kyn-strategy .diag .dv { font-size: 38px; }
  .kyn-strategy .diag .dmeta {
    flex-wrap: wrap;
    padding: 16px 24px;
    font-size: 13px;
  }
  .kyn-strategy .qbody { padding: 0 22px 24px; }
  .kyn-strategy .qhead { grid-template-columns: 34px 1fr 18px; padding: 22px; }
  .kyn-strategy .prow {
    align-items: flex-start;
    flex-direction: column;
    gap: 7px;
  }
  .kyn-strategy .prow .pl-meta {
    white-space: normal;
  }
}

/* Tax analysis: deductions should read as calculation flow, not negative charges */
.tax-page .tax-deductions-card,
.tax-page .tax-gift-deductions-card {
  border-color: var(--line-strong);
  background: var(--paper);
}

.tax-page .deduction-flow {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border: 1px solid var(--line);
  background: var(--bg);
}

.tax-page .deduction-flow > div {
  min-height: 92px;
  padding: 18px 20px;
  border-right: 1px solid var(--line);
}

.tax-page .deduction-flow > div:last-child {
  border-right: 0;
}

.tax-page .deduction-flow span {
  display: block;
  color: var(--ink-faint);
  font-size: 12px;
  letter-spacing: -0.01em;
}

.tax-page .deduction-flow strong {
  display: block;
  margin-top: 12px;
  color: var(--ink);
  font-family: var(--serif);
  font-size: 28px;
  font-weight: 500;
  letter-spacing: -0.035em;
}

.tax-page .deduction-list .v.pos {
  color: var(--gold-deep);
}

.tax-page .deduction-list .v.neg {
  color: var(--red);
}

.tax-page .gift-deduction-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 10px;
}

.tax-page .gift-deduction-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  min-height: 62px;
  padding: 14px 16px;
  border: 1px solid var(--line);
  background: var(--bg);
}

.tax-page .gift-deduction-item .name {
  color: var(--ink);
  font-size: 14px;
  font-weight: 600;
}

.tax-page .gift-deduction-item .relation {
  margin-left: 8px;
  color: var(--ink-faint);
  font-size: 12px;
}

.tax-page .gift-deduction-item strong {
  color: var(--gold-deep);
  font-family: var(--serif);
  font-size: 24px;
  font-weight: 500;
}

@media (max-width: 760px) {
  .tax-page .deduction-flow {
    grid-template-columns: 1fr;
  }

  .tax-page .deduction-flow > div {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .tax-page .deduction-flow > div:last-child {
    border-bottom: 0;
  }
}

@media (max-width: 560px) {
  .kyn-strategy .mini,
  .kyn-strategy .diag .dtop {
    grid-template-columns: 1fr;
  }
  .kyn-strategy .mini > div,
  .kyn-strategy .diag .dc {
    border-right: none;
  }
  .kyn-strategy .mini > div:nth-last-child(-n + 2) {
    border-bottom: 1px solid var(--line);
  }
  .kyn-strategy .mini > div:last-child,
  .kyn-strategy .diag .dc:last-child {
    border-bottom: none;
  }
  .kyn-strategy .reducer .rh {
    flex-direction: column;
  }
  .kyn-strategy .reducer .rpct {
    width: 100%;
    text-align: left;
  }
}

/* Strategy page final visual pass — match Claude design reference */
.kyn-strategy {
  max-width: 1680px;
  padding: 48px 72px 96px;
}

.kyn-strategy .card {
  border-color: var(--line-strong);
}

.kyn-strategy .setbody {
  gap: 34px;
  padding: 34px 48px 48px;
}

.kyn-strategy .fgrid {
  grid-template-columns: 1fr 1fr;
  gap: 42px;
}

.kyn-strategy .flab {
  margin-bottom: 14px;
  color: var(--ink);
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.kyn-strategy select.kyn,
.kyn-strategy input.kyn {
  min-height: 58px;
  border-color: var(--line-strong);
  color: var(--ink);
  font-size: 18px;
  padding: 14px 22px;
}

.kyn-strategy select.kyn {
  background-position: calc(100% - 26px) 26px, calc(100% - 18px) 26px;
}

.kyn-strategy .checks {
  gap: 12px;
}

.kyn-strategy .chk {
  border: 1px solid rgba(154, 123, 46, 0.45);
  background: var(--bg);
  color: var(--ink-soft);
  font-size: 16px;
  padding: 12px 16px;
}

.kyn-strategy .small-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 34px;
}

.kyn-strategy .small-grid .sl {
  margin-bottom: 12px;
  color: var(--ink-faint);
  font-size: 17px;
}

.kyn-strategy .diag {
  margin: 48px 0 64px;
  border-color: var(--line-strong);
  background: var(--bg);
}

.kyn-strategy .diag .dc {
  min-height: 250px;
  padding: 54px 52px 46px;
}

.kyn-strategy .diag .dl {
  margin-bottom: 28px;
  color: var(--ink-faint);
  font-size: 24px;
  font-weight: 400;
  letter-spacing: -0.03em;
}

.kyn-strategy .diag .dv {
  font-size: 64px;
  letter-spacing: -0.045em;
}

.kyn-strategy .diag .dv .u,
.kyn-strategy .diag .dv.num {
  white-space: nowrap;
}

.kyn-strategy .diag .dc.save .dl {
  color: var(--green-ink);
  font-family: var(--sans);
  font-size: 22px;
  font-weight: 600;
}

.kyn-strategy .diag .dc.save .dv {
  color: var(--green-ink);
}

.kyn-strategy .diag .dmeta {
  min-height: 112px;
  gap: 26px;
  padding: 28px 52px;
  color: var(--ink-faint);
  font-size: 24px;
}

.kyn-strategy .badge {
  border-color: rgba(140, 58, 44, 0.35);
  background: var(--bg);
  color: var(--red);
  font-size: 22px;
  padding: 12px 20px;
}

.kyn-strategy .badge .dot {
  width: 13px;
  height: 13px;
}

.kyn-strategy .qsec {
  margin-bottom: 32px;
  border-color: var(--line-strong);
}

.kyn-strategy .qsec[data-open="true"] {
  border-color: var(--line-strong);
}

.kyn-strategy .qhead {
  display: grid !important;
  grid-template-columns: 104px minmax(0, 1fr) 36px;
  align-items: start;
  gap: 24px;
  min-height: 160px;
  padding: 52px 52px 42px;
}

.kyn-strategy .qhead .qn {
  grid-column: 1;
  justify-self: start;
  padding-top: 2px;
  color: var(--gold-deep);
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.12em;
  line-height: 1.45;
  white-space: nowrap;
}

.kyn-strategy .qhead .qcopy {
  grid-column: 2;
}

.kyn-strategy .qhead h3 {
  font-size: 34px;
  line-height: 1.25;
  font-weight: 600;
}

.kyn-strategy .qhead .qd {
  margin-top: 13px;
  font-size: 22px;
  line-height: 1.45;
}

.kyn-strategy .qhead .chev {
  grid-column: 3;
  width: 20px;
  height: 20px;
  margin-top: 8px;
}

.kyn-strategy .qbody {
  padding: 0 52px 52px 124px;
}

.kyn-strategy .reducer {
  padding: 36px 42px;
}

.kyn-strategy .reducer .rt {
  font-size: 22px;
}

.kyn-strategy .reducer .rd,
.kyn-strategy .rnote {
  font-size: 15px;
}

.kyn-strategy .reducer .rpct {
  min-width: 150px;
  padding: 18px 22px;
}

.kyn-strategy .reducer .rpct .rv {
  font-size: 44px;
}

@media (max-width: 1280px) {
  .kyn-strategy {
    padding: 44px 52px 84px;
  }
  .kyn-strategy .diag .dc {
    padding: 42px 36px;
  }
  .kyn-strategy .diag .dv {
    font-size: 54px;
  }
  .kyn-strategy .diag .dl,
  .kyn-strategy .diag .dmeta {
    font-size: 20px;
  }
  .kyn-strategy .qhead h3 {
    font-size: 28px;
  }
  .kyn-strategy .qhead .qd {
    font-size: 18px;
  }
}

@media (max-width: 860px) {
  .kyn-strategy {
    padding: 30px 20px 64px;
  }
  .kyn-strategy .setbody {
    padding: 24px;
  }
  .kyn-strategy .fgrid,
  .kyn-strategy .small-grid {
    grid-template-columns: 1fr;
    gap: 22px;
  }
  .kyn-strategy .flab {
    font-size: 15px;
  }
  .kyn-strategy select.kyn,
  .kyn-strategy input.kyn {
    min-height: 48px;
    font-size: 15px;
    padding: 11px 14px;
  }
  .kyn-strategy select.kyn {
    background-position: calc(100% - 19px) 18px, calc(100% - 13px) 18px;
  }
  .kyn-strategy .small-grid .sl {
    font-size: 13px;
  }
  .kyn-strategy .diag {
    margin: 32px 0 42px;
  }
  .kyn-strategy .diag .dc {
    padding: 30px 26px;
  }
  .kyn-strategy .diag .dl {
    font-size: 17px;
    margin-bottom: 14px;
  }
  .kyn-strategy .diag .dv {
    font-size: 40px;
  }
  .kyn-strategy .diag .dmeta {
    min-height: auto;
    padding: 18px 24px;
    font-size: 14px;
  }
  .kyn-strategy .badge {
    font-size: 13px;
    padding: 7px 12px;
  }
  .kyn-strategy .qhead {
    grid-template-columns: 72px minmax(0, 1fr) 22px;
    min-height: 112px;
    padding: 28px 26px;
  }
  .kyn-strategy .qhead .qn {
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .kyn-strategy .qhead h3 {
    font-size: 22px;
  }
  .kyn-strategy .qhead .qd {
    font-size: 14px;
  }
  .kyn-strategy .qbody {
    padding: 0 24px 30px;
  }
}

/* Strategy page proportion reset — final brand pass */
.kyn-strategy {
