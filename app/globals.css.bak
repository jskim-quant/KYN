  gap: 46px !important;
  align-items: start !important;
}

.kyn-strategy .field {
  display: grid !important;
  gap: 12px !important;
}

.kyn-strategy .flab,
.kyn-strategy .field label,
.kyn-strategy .giftrow label,
.kyn-strategy .checks-label {
