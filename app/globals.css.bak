}

.kyn-strategy .strat {
  display: grid !important;
  grid-template-columns: 48px 1fr auto !important;
  gap: 28px !important;
  align-items: center !important;
  min-height: 138px !important;
  padding: 34px 36px !important;
  border: 0 !important;
  border-bottom: 1px solid #dedede !important;
