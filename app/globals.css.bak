  border-width: 0 1.5px 1.5px 0 !important;
  transform: rotate(45deg) !important;
}

.kyn-strategy .qsec[data-open="true"] .qhead .chev {
  transform: rotate(225deg) !important;
}

.kyn-strategy .qbody {
  padding: 0 48px 48px 122px !important;
}

.kyn-strategy .qbody > * {
  max-width: 1020px !important;
}

.kyn-strategy .qbody > .rounded-2xl,
.kyn-strategy .qbody > .reducer,
.kyn-strategy .qbody > .border {
  border-radius: 0 !important;
