  border-bottom: 1px solid var(--line) !important;
  border-radius: 0 !important;
  background: #fff !important;
  display: grid !important;
  grid-template-columns: 28px minmax(0, 1fr) 136px !important;
  align-items: center !important;
  gap: 14px !important;
}

.kyn-strategy .strat:last-child {
  border-bottom: 0 !important;
}

.kyn-strategy .strat[data-selected="true"] {
  background: var(--gold-tint) !important;
}

.kyn-strategy .strat .stags {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 8px !important;
  margin-bottom: 7px !important;
}

.kyn-strategy .pill,
.kyn-strategy .strat .pill {
  border-radius: 0 !important;
  padding: 4px 8px !important;
  background: var(--paper) !important;
  color: var(--ink-soft) !important;
  font-size: 11px !important;
  font-weight: 600 !important;
}

.kyn-strategy .strat .stitle {
  color: var(--ink) !important;
  font-size: 15px !important;
  font-weight: 700 !important;
  letter-spacing: -0.02em !important;
}

.kyn-strategy .strat .slaw {
  margin-top: 4px !important;
  color: var(--ink-faint) !important;
  font-size: 12px !important;
  line-height: 1.6 !important;
}

.kyn-strategy .strat .simp {
  text-align: right !important;
  color: var(--ink) !important;
}

.kyn-strategy .strat .simp .il {
  display: block !important;
  margin-bottom: 4px !important;
  color: var(--ink-faint) !important;
  font-size: 11px !important;
  font-weight: 400 !important;
}

.kyn-strategy .strat .simp .iv {
  color: var(--green-ink) !important;
  font-size: 20px !important;
  font-weight: 700 !important;
  letter-spacing: -0.02em !important;
}

.kyn-strategy .stratfoot {
  margin-top: 18px !important;
  padding: 18px 20px !important;
  border: 1px solid var(--line) !important;
  background: var(--paper) !important;
  color: var(--ink-soft) !important;
  font-size: 14px !important;
  line-height: 1.75 !important;
}

@media (max-width: 980px) {
  .kyn-strategy {
    padding: 34px 20px 72px !important;
  }

  .kyn-strategy .diag .dtop,
  .kyn-strategy .rmini {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }

  .kyn-strategy .fgrid,
  .kyn-strategy .small-grid {
    grid-template-columns: 1fr !important;
  }

  .kyn-strategy .qhead {
    grid-template-columns: 48px 1fr 24px !important;
    padding: 32px 28px 26px !important;
  }

  .kyn-strategy .qbody {
    padding: 0 28px 36px !important;
  }
}

/* KYN strategy final visual system.
   Keep this block last: older strategy rules above are intentionally overridden here. */
body:has(.kyn-strategy) {
  background: #fff !important;
}

body:has(.kyn-strategy) main {
  max-width: none !important;
  padding: 0 !important;
}

.kyn-strategy {
  width: min(100% - 96px, 1560px) !important;
  max-width: 1560px !important;
  margin: 0 auto !important;
  padding: 88px 0 132px !important;
  color: var(--ink) !important;
  font-family: var(--sans) !important;
  font-size: 18px !important;
  line-height: 1.62 !important;
  letter-spacing: -0.02em !important;
}

.kyn-strategy .crumb {
  margin-bottom: 26px !important;
  color: var(--ink-faint) !important;
  font-family: var(--sans) !important;
  font-size: 18px !important;
  font-weight: 700 !important;
  letter-spacing: 0.32em !important;
  text-transform: uppercase !important;
}

.kyn-strategy .pagehead {
  display: grid !important;
  grid-template-columns: 1fr auto !important;
  align-items: end !important;
  gap: 48px !important;
  margin: 0 0 56px !important;
  padding: 0 0 58px !important;
  border-bottom: 1px solid #dedede !important;
}

.kyn-strategy .pagehead h1 {
  margin: 0 !important;
  color: var(--ink) !important;
  font-family: var(--serif) !important;
  font-size: 58px !important;
  font-weight: 400 !important;
  line-height: 1.08 !important;
  letter-spacing: -0.075em !important;
}

.kyn-strategy .pagehead .desc {
  margin-top: 18px !important;
  color: var(--ink-faint) !important;
  font-size: 23px !important;
  line-height: 1.5 !important;
}

.kyn-strategy .hero-cta {
  display: inline-flex !important;
  min-width: 238px !important;
  height: 84px !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 42px !important;
  border: 0 !important;
  background: #1c1d1f !important;
  color: #fff !important;
  font-size: 23px !important;
  font-weight: 800 !important;
  text-decoration: none !important;
}

.kyn-strategy .rule {
  display: none !important;
}

.kyn-strategy .block,
.kyn-strategy .card,
.kyn-strategy .qsec,
.kyn-strategy .save-panel {
  border: 1px solid #d6d6d6 !important;
  border-radius: 0 !important;
  background: #fff !important;
  box-shadow: none !important;
}

.kyn-strategy .stepbar.block {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  min-height: 96px !important;
  margin: 0 0 40px !important;
  padding: 0 42px !important;
  border-left: 2px solid var(--gold) !important;
  color: var(--ink-soft) !important;
  font-size: 20px !important;
}

.kyn-strategy .stepbar strong {
  color: var(--ink) !important;
  font-size: 22px !important;
  font-weight: 800 !important;
}

.kyn-strategy .stepbar a {
  color: var(--gold-deep) !important;
  font-size: 19px !important;
  font-weight: 800 !important;
  text-decoration: none !important;
}

.kyn-strategy .card.block {
  margin: 0 0 48px !important;
  padding: 0 !important;
}

.kyn-strategy .cardhead,
.kyn-strategy .sethead {
  display: flex !important;
  align-items: flex-start !important;
  justify-content: space-between !important;
  gap: 32px !important;
  padding: 42px 48px !important;
  border-bottom: 1px solid #dedede !important;
}

.kyn-strategy .ctag,
.kyn-strategy .seteyebrow,
.kyn-strategy .eyebrow {
  color: var(--ink-faint) !important;
  font-size: 17px !important;
  font-weight: 800 !important;
  letter-spacing: 0.28em !important;
  text-transform: uppercase !important;
}

.kyn-strategy .ctitle,
.kyn-strategy .settitle {
  margin-top: 12px !important;
  color: var(--ink) !important;
  font-size: 26px !important;
  font-weight: 800 !important;
  line-height: 1.35 !important;
}

.kyn-strategy .cdesc,
.kyn-strategy .setdesc {
  margin-top: 8px !important;
