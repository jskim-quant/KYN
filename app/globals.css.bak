  color: var(--ink) !important;
  font-size: 13px !important;
}

.kyn-strategy .preset.active {
  border-color: var(--ink) !important;
  background: var(--ink) !important;
  color: var(--paper) !important;
}

.kyn-strategy .rmini {
  display: grid !important;
  grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
  gap: 0 !important;
  margin-top: 20px !important;
  border: 1px solid var(--line) !important;
  background: var(--paper) !important;
}

.kyn-strategy .rmini > div {
  min-height: 76px !important;
  padding: 18px 18px 16px !important;
  border-right: 1px solid var(--line) !important;
}

.kyn-strategy .rmini > div:last-child {
  border-right: 0 !important;
}

.kyn-strategy .rmini .k {
  margin-bottom: 8px !important;
  color: var(--ink-faint) !important;
  font-size: 12px !important;
}

.kyn-strategy .rmini .v {
  color: var(--ink) !important;
  font-size: 20px !important;
  font-weight: 700 !important;
  line-height: 1.15 !important;
}

.kyn-strategy .rnote {
  margin-top: 18px !important;
  padding: 18px 20px !important;
  border: 1px solid var(--line) !important;
  background: var(--paper) !important;
  color: var(--ink-muted) !important;
  font-size: 14px !important;
  line-height: 1.75 !important;
}

@media (max-width: 980px) {
  .kyn-strategy {
    padding: 32px 22px 72px !important;
  }

  .kyn-strategy .fgrid,
  .kyn-strategy .small-grid,
  .kyn-strategy .rmini {
    grid-template-columns: 1fr !important;
  }

  .kyn-strategy .diag .dtop {
    grid-template-columns: 1fr 1fr !important;
  }

  .kyn-strategy .diag .dc {
    border-bottom: 1px solid var(--line) !important;
  }

  .kyn-strategy .qhead {
    grid-template-columns: 48px minmax(0, 1fr) 22px !important;
    padding: 30px 26px 26px !important;
  }

  .kyn-strategy .qbody {
    padding: 0 26px 32px 74px !important;
  }
}

/* KYN strategy analysis: final end-of-file override from standalone design */
.kyn-strategy {
  max-width: 1240px !important;
  margin: 0 auto !important;
  padding: 48px 40px 96px !important;
  background: var(--bg) !important;
  color: var(--ink) !important;
  font-family: var(--sans) !important;
}

.kyn-strategy .pagehead {
  margin-bottom: 38px !important;
  padding-bottom: 34px !important;
  border-bottom: 1px solid var(--line) !important;
}

.kyn-strategy .pagehead h1 {
  font-family: var(--serif) !important;
  font-size: 38px !important;
  line-height: 1.18 !important;
  font-weight: 500 !important;
  letter-spacing: -0.07em !important;
}

.kyn-strategy .card.block {
  margin: 0 0 32px !important;
  border: 1px solid var(--line) !important;
  background: #fff !important;
  box-shadow: none !important;
}

.kyn-strategy .setbody {
  padding: 32px !important;
  display: grid !important;
  gap: 32px !important;
}

.kyn-strategy .flab {
  display: block !important;
  margin-bottom: 11px !important;
  color: var(--ink) !important;
  font-size: 14px !important;
  font-weight: 700 !important;
}

.kyn-strategy select.kyn,
.kyn-strategy input.kyn {
  height: 48px !important;
  border: 1px solid var(--line-strong) !important;
  border-radius: 0 !important;
  background: #fff !important;
  padding: 0 14px !important;
  color: var(--ink) !important;
  font-size: 15px !important;
  font-family: var(--sans) !important;
  box-shadow: none !important;
}

.kyn-strategy .checks {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 10px !important;
}

.kyn-strategy .chk {
  min-height: 42px !important;
  padding: 0 16px !important;
  border: 1px solid rgba(154, 123, 46, 0.45) !important;
  border-radius: 0 !important;
  background: #fff !important;
  color: var(--ink-soft) !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  font-size: 14px !important;
}

.kyn-strategy .chk input {
  accent-color: var(--gold-deep) !important;
}

.kyn-strategy .fgrid {
  display: grid !important;
