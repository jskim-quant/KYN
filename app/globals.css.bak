}

.kyn-strategy .strat .check {
  width: 34px !important;
  height: 34px !important;
  border: 3px solid #9ca0a4 !important;
  border-radius: 8px !important;
  background: #fff !important;
}

.kyn-strategy .strat[data-selected="true"] .check {
  border-color: var(--gold) !important;
  background: var(--gold) !important;
}

.kyn-strategy .strat .stitle {
  color: var(--ink) !important;
  font-size: 28px !important;
  font-weight: 900 !important;
  line-height: 1.3 !important;
}

.kyn-strategy .strat .slaw {
  margin-top: 8px !important;
  color: var(--ink-faint) !important;
  font-size: 21px !important;
  line-height: 1.4 !important;
}

.kyn-strategy .strat .simp {
  min-width: 150px !important;
  text-align: right !important;
}

.kyn-strategy .strat .il {
  color: var(--ink-faint) !important;
  font-size: 18px !important;
}

.kyn-strategy .strat .iv {
  margin-top: 6px !important;
  color: var(--green-ink) !important;
  font-family: var(--serif) !important;
  font-size: 38px !important;
  font-weight: 400 !important;
  line-height: 1 !important;
}

.kyn-strategy .stratfoot {
  padding: 30px 36px !important;
  border-top: 1px solid #dedede !important;
  background: #fbfbfb !important;
  color: var(--ink-soft) !important;
  font-size: 21px !important;
  line-height: 1.7 !important;
}

.kyn-strategy .save-panel.block {
  display: grid !important;
  grid-template-columns: 1fr minmax(340px, 520px) !important;
  gap: 48px !important;
  align-items: center !important;
  margin: 64px 0 !important;
  padding: 48px !important;
  border-color: var(--gold) !important;
}

.kyn-strategy .save-panel h3 {
  margin: 0 0 18px !important;
  color: var(--ink) !important;
  font-size: 31px !important;
  font-weight: 900 !important;
  line-height: 1.3 !important;
}

.kyn-strategy .save-panel p {
  color: var(--ink-soft) !important;
  font-size: 22px !important;
  line-height: 1.65 !important;
}

.kyn-strategy .save-panel button,
.kyn-strategy .save-panel a {
  min-height: 72px !important;
  border-radius: 0 !important;
  font-size: 21px !important;
  font-weight: 900 !important;
}

.kyn-strategy .pay-section,
.kyn-strategy .action-timeline,
.kyn-strategy .qbody > .space-y-4 {
  border: 1px solid #dedede !important;
  border-radius: 0 !important;
  background: #fff !important;
  padding: 42px !important;
}

.kyn-strategy .pay-section h3,
.kyn-strategy .action-timeline h3,
.kyn-strategy .qbody > .space-y-4 h3 {
  color: var(--ink) !important;
  font-size: 30px !important;
  font-weight: 900 !important;
  letter-spacing: -0.03em !important;
}

.kyn-strategy table {
  width: 100% !important;
  border-collapse: collapse !important;
}

.kyn-strategy table th,
.kyn-strategy table td {
  padding: 24px 22px !important;
  border-bottom: 1px solid #dedede !important;
  color: var(--ink-soft) !important;
  font-size: 20px !important;
  line-height: 1.45 !important;
}

.kyn-strategy table th {
  color: var(--ink-faint) !important;
  font-weight: 800 !important;
}

@media (max-width: 1180px) {
  .kyn-strategy {
    width: min(100% - 40px, 980px) !important;
    padding: 56px 0 96px !important;
    font-size: 16px !important;
  }

  .kyn-strategy .pagehead,
  .kyn-strategy .diag .dtop,
  .kyn-strategy .formgrid,
  .kyn-strategy .giftrow,
  .kyn-strategy .save-panel.block {
    grid-template-columns: 1fr !important;
  }

  .kyn-strategy .pagehead h1 {
    font-size: 44px !important;
  }

  .kyn-strategy .diag .dc {
    min-height: auto !important;
    border-right: 0 !important;
    border-bottom: 1px solid #dedede !important;
  }

  .kyn-strategy .qhead {
    grid-template-columns: 52px 1fr 28px !important;
    padding: 42px 28px 30px !important;
    gap: 22px !important;
  }

  .kyn-strategy .qbody {
    padding: 0 28px 42px !important;
  }

  .kyn-strategy .rmini {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}

/* Strategy analysis final reference lock — based on KYN standalone design. */
body:has(.kyn-strategy) {
  background: #fff !important;
}

.kyn-strategy {
  --kyn-ref-ink: #1e1f22;
  --kyn-ref-muted: #8d929a;
  --kyn-ref-soft: #f7f7f5;
  --kyn-ref-line: #d8d8d6;
  --kyn-ref-line-strong: #c9c9c7;
  --kyn-ref-gold: #8b6b1f;
  --kyn-ref-gold-soft: #f4efe4;
  --kyn-ref-red: #963b2d;
  --kyn-ref-red-soft: #f2e9e6;
  --kyn-ref-green: #20382c;
  --kyn-ref-green-soft: #eef2ef;

  max-width: min(1500px, calc(100vw - 96px)) !important;
  margin: 0 auto !important;
  padding: 82px 0 124px !important;
  color: var(--kyn-ref-ink) !important;
  font-family: var(--sans) !important;
  font-size: 18px !important;
  line-height: 1.55 !important;
  letter-spacing: -0.018em !important;
}

.kyn-strategy *,
.kyn-strategy *::before,
.kyn-strategy *::after {
  box-sizing: border-box !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}

.kyn-strategy .crumb,
.kyn-strategy .section-label {
  margin: 0 0 26px !important;
  color: var(--kyn-ref-muted) !important;
  font-family: var(--sans) !important;
  font-size: 15px !important;
  font-weight: 600 !important;
  letter-spacing: 0.34em !important;
  line-height: 1 !important;
  text-transform: uppercase !important;
}

.kyn-strategy .pagehead {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 48px !important;
  margin: 0 0 48px !important;
  padding: 0 0 54px !important;
  border-bottom: 1px solid var(--kyn-ref-line) !important;
}

.kyn-strategy .pagehead h1 {
  margin: 0 !important;
  color: var(--kyn-ref-ink) !important;
  font-family: var(--serif) !important;
  font-size: clamp(42px, 3.25vw, 58px) !important;
  font-weight: 400 !important;
  line-height: 1.08 !important;
  letter-spacing: -0.065em !important;
}

.kyn-strategy .pagehead .desc,
.kyn-strategy .pagehead p {
  max-width: 760px !important;
  margin: 16px 0 0 !important;
  color: var(--kyn-ref-muted) !important;
  font-family: var(--sans) !important;
  font-size: 20px !important;
  font-weight: 400 !important;
  line-height: 1.65 !important;
}

.kyn-strategy .hero-cta {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 250px !important;
  min-height: 88px !important;
  border: 1px solid var(--kyn-ref-ink) !important;
  background: var(--kyn-ref-ink) !important;
  color: #fff !important;
  font-size: 22px !important;
  font-weight: 800 !important;
  text-decoration: none !important;
  white-space: nowrap !important;
}

.kyn-strategy .rule {
  display: none !important;
}

.kyn-strategy .block,
.kyn-strategy .card.block,
.kyn-strategy .diag.block,
.kyn-strategy .qsec.block,
.kyn-strategy .save-panel.block {
  margin: 0 0 54px !important;
  border: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
}

.kyn-strategy .stepbar.block {
  display: flex !important;
  min-height: 96px !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 24px !important;
  padding: 0 44px !important;
  border-left: 3px solid var(--kyn-ref-gold) !important;
  background: #fbfbfa !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 20px !important;
  line-height: 1.45 !important;
}

.kyn-strategy .stepbar strong,
.kyn-strategy .stepbar b {
  color: var(--kyn-ref-ink) !important;
  font-size: 21px !important;
  font-weight: 800 !important;
}

.kyn-strategy .link,
.kyn-strategy a.link {
  color: var(--kyn-ref-gold) !important;
  font-size: 18px !important;
  font-weight: 800 !important;
  text-decoration: none !important;
}

.kyn-strategy .card-head {
  display: flex !important;
  min-height: 136px !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 32px !important;
  padding: 42px 46px 34px !important;
  border-bottom: 1px solid var(--kyn-ref-line) !important;
}

.kyn-strategy .card-head .t {
  color: var(--kyn-ref-ink) !important;
  font-size: 25px !important;
  font-weight: 800 !important;
  line-height: 1.35 !important;
}

.kyn-strategy .card-head .sub {
  display: block !important;
  margin-top: 10px !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 19px !important;
  font-weight: 400 !important;
  line-height: 1.55 !important;
}

.kyn-strategy .mini {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  gap: 0 !important;
  margin: 0 !important;
  border: 0 !important;
  border-bottom: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
}

.kyn-strategy .mini > div {
  min-height: 148px !important;
  padding: 34px 42px !important;
  border-right: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
}

.kyn-strategy .mini > div:last-child {
  border-right: 0 !important;
}

.kyn-strategy .mini .l {
  margin-bottom: 16px !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 18px !important;
  font-weight: 500 !important;
  line-height: 1.35 !important;
}

.kyn-strategy .mini .n {
  color: var(--kyn-ref-ink) !important;
  font-family: var(--sans) !important;
  font-size: 34px !important;
  font-weight: 800 !important;
  line-height: 1.05 !important;
  letter-spacing: -0.045em !important;
}

.kyn-strategy .planlist {
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
}

.kyn-strategy .prow {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  min-height: 78px !important;
  padding: 0 46px !important;
  border: 0 !important;
  border-bottom: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 20px !important;
  line-height: 1.45 !important;
}

.kyn-strategy .prow .pl-name {
  color: var(--kyn-ref-ink) !important;
  font-size: 21px !important;
}

.kyn-strategy .prow .pl-name b,
.kyn-strategy .pl-name strong {
  font-weight: 800 !important;
}

.kyn-strategy .prow .arr {
  margin: 0 18px !important;
  color: var(--kyn-ref-muted) !important;
}

.kyn-strategy .prow .pl-meta {
  color: var(--kyn-ref-muted) !important;
  font-size: 18px !important;
}

.kyn-strategy .setbody {
  padding: 54px 70px 62px !important;
}

.kyn-strategy .fgrid {
  display: grid !important;
  grid-template-columns: minmax(420px, 0.9fr) 1fr !important;
  gap: 64px 88px !important;
  align-items: start !important;
}

.kyn-strategy .flab,
.kyn-strategy label {
  margin: 0 0 14px !important;
  color: var(--kyn-ref-ink) !important;
  font-size: 21px !important;
  font-weight: 800 !important;
  line-height: 1.35 !important;
}

.kyn-strategy select.kyn,
.kyn-strategy input.kyn,
.kyn-strategy .kyn-input {
  height: 72px !important;
  padding: 0 26px !important;
  border: 1px solid var(--kyn-ref-line-strong) !important;
  background: #fff !important;
  color: var(--kyn-ref-ink) !important;
  font-family: var(--sans) !important;
  font-size: 22px !important;
  font-weight: 500 !important;
  line-height: 72px !important;
}

.kyn-strategy input.kyn.short {
  width: 210px !important;
}

.kyn-strategy .checks {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 18px !important;
  margin-top: 20px !important;
}

.kyn-strategy .chk {
  display: inline-flex !important;
  min-height: 58px !important;
  align-items: center !important;
  gap: 12px !important;
  padding: 0 24px !important;
  border: 1px solid color-mix(in srgb, var(--kyn-ref-gold) 48%, var(--kyn-ref-line)) !important;
  background: #fff !important;
  color: var(--kyn-ref-ink) !important;
  font-size: 20px !important;
  font-weight: 500 !important;
}

.kyn-strategy .chk input {
  width: 18px !important;
  height: 18px !important;
  accent-color: var(--kyn-ref-gold) !important;
}

.kyn-strategy .small-grid {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 32px !important;
}

.kyn-strategy .small-grid .sl {
  color: var(--kyn-ref-muted) !important;
  font-size: 18px !important;
  line-height: 1.45 !important;
}

.kyn-strategy .diag.block {
  overflow: hidden !important;
}

.kyn-strategy .diag .dtop {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
}

.kyn-strategy .diag .dc {
  min-height: 240px !important;
  padding: 52px 48px 46px !important;
  border-right: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
}

.kyn-strategy .diag .dc:last-child {
  border-right: 0 !important;
}

.kyn-strategy .diag .dc.alert {
  background: var(--kyn-ref-red-soft) !important;
}

.kyn-strategy .diag .dc.save {
  background: var(--kyn-ref-green-soft) !important;
}

.kyn-strategy .diag .dl {
  margin: 0 0 26px !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 21px !important;
  font-weight: 500 !important;
  line-height: 1.35 !important;
}

.kyn-strategy .diag .dv {
  color: var(--kyn-ref-ink) !important;
  font-family: var(--serif) !important;
  font-size: clamp(54px, 4.1vw, 76px) !important;
  font-weight: 400 !important;
  line-height: 0.98 !important;
  letter-spacing: -0.075em !important;
}

.kyn-strategy .diag .dc.alert .dv {
  color: var(--kyn-ref-red) !important;
}

.kyn-strategy .diag .dc.save .dv {
  color: var(--kyn-ref-green) !important;
}

.kyn-strategy .diag .dv .u,
.kyn-strategy .diag .u {
  margin-left: 6px !important;
  color: var(--kyn-ref-muted) !important;
  font-family: var(--serif) !important;
  font-size: 30px !important;
}

.kyn-strategy .diag .dsub {
  margin-top: 22px !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 19px !important;
  line-height: 1.45 !important;
}

.kyn-strategy .diag .dmeta {
  display: flex !important;
  min-height: 86px !important;
  align-items: center !important;
  gap: 30px !important;
  padding: 0 48px !important;
  border-top: 1px solid var(--kyn-ref-line) !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 21px !important;
}

.kyn-strategy .badge {
  display: inline-flex !important;
  min-height: 48px !important;
  align-items: center !important;
  gap: 10px !important;
  padding: 0 24px !important;
  border: 1px solid color-mix(in srgb, var(--kyn-ref-red) 34%, var(--kyn-ref-line)) !important;
  background: color-mix(in srgb, var(--kyn-ref-red) 4%, #fff) !important;
  color: var(--kyn-ref-red) !important;
  font-size: 21px !important;
  font-weight: 800 !important;
}

.kyn-strategy .badge .dot {
  width: 10px !important;
  height: 10px !important;
  background: var(--kyn-ref-red) !important;
}

.kyn-strategy .qsec.block,
.kyn-strategy .qsec {
  margin: 64px 0 !important;
  border: 1px solid var(--kyn-ref-line-strong) !important;
  background: #fff !important;
}

.kyn-strategy .qhead {
  display: grid !important;
  grid-template-columns: 80px 1fr 36px !important;
  gap: 40px !important;
  align-items: start !important;
  width: 100% !important;
  padding: 62px 58px 48px !important;
  border: 0 !important;
  background: #fff !important;
  text-align: left !important;
}

.kyn-strategy .qhead .qn {
  color: var(--kyn-ref-gold) !important;
  font-family: var(--serif) !important;
  font-size: 25px !important;
  font-weight: 400 !important;
  line-height: 1.1 !important;
}

.kyn-strategy .qhead h3 {
  margin: 0 !important;
  color: var(--kyn-ref-ink) !important;
  font-family: var(--serif) !important;
  font-size: clamp(36px, 2.65vw, 48px) !important;
  font-weight: 400 !important;
  line-height: 1.2 !important;
  letter-spacing: -0.055em !important;
}

.kyn-strategy .qhead .qd {
  margin-top: 16px !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 22px !important;
  font-weight: 400 !important;
  line-height: 1.45 !important;
}

.kyn-strategy .chev {
  width: 28px !important;
  height: 28px !important;
  border: 0 !important;
  background: transparent !important;
}

.kyn-strategy .chev::before {
  width: 24px !important;
  height: 24px !important;
  border-color: var(--kyn-ref-muted) !important;
}

.kyn-strategy .qbody {
  padding: 0 58px 62px 138px !important;
}

.kyn-strategy .bracket,
.kyn-strategy .reducer,
.kyn-strategy .method-panel,
.kyn-strategy .preserve,
.kyn-strategy .money-panel {
  border: 1px solid var(--kyn-ref-line) !important;
  border-left: 3px solid var(--kyn-ref-gold) !important;
  background: #fbfbfa !important;
}

.kyn-strategy .bracket {
  padding: 46px 54px !important;
}

.kyn-strategy .bracket-flow,
.kyn-strategy .bracket .btop {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 28px !important;
  align-items: center !important;
  color: var(--kyn-ref-ink) !important;
  font-size: 26px !important;
  font-weight: 800 !important;
  line-height: 1.35 !important;
}

.kyn-strategy .bracket-bar {
  display: grid !important;
  grid-template-columns: repeat(5, 1fr) !important;
  gap: 6px !important;
  margin: 52px 0 26px !important;
}

.kyn-strategy .bracket-seg::before,
.kyn-strategy .bracket-seg {
  height: 14px !important;
  background: var(--kyn-ref-gold) !important;
}

.kyn-strategy .bracket-seg:last-child::before,
.kyn-strategy .bracket-seg:last-child {
  background: var(--kyn-ref-green) !important;
}

.kyn-strategy .bracket-seg span {
  margin-top: 26px !important;
  color: var(--kyn-ref-ink) !important;
  font-size: 25px !important;
  font-weight: 900 !important;
}

.kyn-strategy .bracket-seg small {
  margin-top: 8px !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 20px !important;
  font-weight: 400 !important;
}

.kyn-strategy .bracket-metrics {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  margin-top: 78px !important;
  border-top: 1px solid var(--kyn-ref-line) !important;
}

.kyn-strategy .bracket-metrics > div {
  min-height: 154px !important;
  padding: 34px 0 24px !important;
  border-right: 1px solid var(--kyn-ref-line) !important;
}

.kyn-strategy .bracket-metrics > div:last-child {
  border-right: 0 !important;
}

.kyn-strategy .bracket-metrics span {
  color: var(--kyn-ref-muted) !important;
  font-size: 20px !important;
}

.kyn-strategy .bracket-metrics strong {
  display: block !important;
  margin-top: 12px !important;
  color: var(--kyn-ref-ink) !important;
  font-family: var(--serif) !important;
  font-size: 50px !important;
  font-weight: 400 !important;
  line-height: 1.05 !important;
  letter-spacing: -0.06em !important;
}

.kyn-strategy .bracket-quote {
  margin-top: 42px !important;
  padding: 0 0 0 34px !important;
  border-left: 4px solid var(--kyn-ref-line-strong) !important;
  color: var(--kyn-ref-ink) !important;
  font-size: 24px !important;
  line-height: 1.75 !important;
}

.kyn-strategy .reducer {
  padding: 48px 54px !important;
}

.kyn-strategy .reducer .rh {
  display: grid !important;
  grid-template-columns: 1fr 160px !important;
  gap: 48px !important;
  align-items: start !important;
}

.kyn-strategy .reducer .rt {
  color: var(--kyn-ref-ink) !important;
  font-family: var(--serif) !important;
  font-size: 30px !important;
  font-weight: 400 !important;
  line-height: 1.35 !important;
  letter-spacing: -0.045em !important;
}

.kyn-strategy .reducer .rd {
  margin-top: 14px !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 20px !important;
  line-height: 1.65 !important;
}

.kyn-strategy .reducer .rpct {
  min-height: 126px !important;
  padding: 22px 20px !important;
  border: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
  text-align: center !important;
}

.kyn-strategy .reducer .rl {
  color: var(--kyn-ref-muted) !important;
  font-size: 16px !important;
}

.kyn-strategy .reducer .rv {
  margin-top: 8px !important;
  color: var(--kyn-ref-gold) !important;
  font-family: var(--serif) !important;
  font-size: 56px !important;
  font-weight: 400 !important;
  line-height: 1 !important;
}

.kyn-strategy .reducer .pct-unit,
.kyn-strategy .reducer .rv span {
  color: var(--kyn-ref-ink) !important;
  font-family: var(--serif) !important;
  font-size: 28px !important;
}

.kyn-strategy .reducer input[type='range'] {
  width: 100% !important;
  margin: 50px 0 20px !important;
}

.kyn-strategy .reducer input[type='range']::-webkit-slider-runnable-track {
  height: 5px !important;
  background: var(--kyn-ref-line-strong) !important;
}

.kyn-strategy .reducer input[type='range']::-webkit-slider-thumb {
  width: 24px !important;
  height: 24px !important;
  margin-top: -10px !important;
  border: 3px solid var(--kyn-ref-gold) !important;
  background: #fff !important;
}

.kyn-strategy .preset {
  min-width: 94px !important;
  height: 58px !important;
  padding: 0 24px !important;
  border: 1px solid var(--kyn-ref-line-strong) !important;
  background: #fff !important;
  color: var(--kyn-ref-ink) !important;
  font-size: 21px !important;
  font-weight: 600 !important;
}

.kyn-strategy .preset.active,
.kyn-strategy .preset[aria-pressed='true'] {
  border-color: var(--kyn-ref-ink) !important;
  background: var(--kyn-ref-ink) !important;
  color: #fff !important;
}

.kyn-strategy .rmini {
  display: grid !important;
  grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
  gap: 0 !important;
  margin: 34px 0 0 !important;
  border: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
}

.kyn-strategy .rmini .rc,
.kyn-strategy .rmini > div {
  min-height: 108px !important;
  padding: 24px 26px !important;
  border-right: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
}

.kyn-strategy .rmini .rcl,
.kyn-strategy .rmini .text-xs {
  color: var(--kyn-ref-muted) !important;
  font-size: 17px !important;
  line-height: 1.4 !important;
}

.kyn-strategy .rmini .rcv,
.kyn-strategy .rmini .font-bold {
  margin-top: 10px !important;
  color: var(--kyn-ref-ink) !important;
  font-size: 25px !important;
  font-weight: 800 !important;
  line-height: 1.25 !important;
}

.kyn-strategy .rnote,
.kyn-strategy .rnote-sub {
  margin-top: 30px !important;
  padding: 26px 30px !important;
  border: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 20px !important;
  line-height: 1.75 !important;
}

.kyn-strategy .ttabs {
  display: grid !important;
  grid-template-columns: repeat(2, 1fr) !important;
  border: 1px solid var(--kyn-ref-line) !important;
  border-bottom: 0 !important;
  background: #fff !important;
}

.kyn-strategy .ttab {
  min-height: 80px !important;
  border-right: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 22px !important;
  font-weight: 800 !important;
}

.kyn-strategy .ttab.active,
.kyn-strategy .ttab[aria-selected='true'] {
  background: var(--kyn-ref-ink) !important;
  color: #fff !important;
}

.kyn-strategy .strats {
  border: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
}

.kyn-strategy .strat,
.kyn-strategy .strategy-row {
  min-height: 116px !important;
  padding: 28px 34px !important;
  border-bottom: 1px solid var(--kyn-ref-line) !important;
  background: #fff !important;
}

.kyn-strategy .strat[data-selected='true'] {
  background: #fff !important;
}

.kyn-strategy .strat .stitle,
.kyn-strategy .strategy-title {
  color: var(--kyn-ref-ink) !important;
  font-size: 24px !important;
  font-weight: 900 !important;
  line-height: 1.35 !important;
}

.kyn-strategy .strat .slaw,
.kyn-strategy .strategy-desc {
  margin-top: 8px !important;
  color: var(--kyn-ref-muted) !important;
  font-size: 18px !important;
  line-height: 1.5 !important;
}

.kyn-strategy .save-panel.block {
  padding: 50px 56px !important;
  border-color: var(--kyn-ref-gold) !important;
}

.kyn-strategy .save-title {
  color: var(--kyn-ref-ink) !important;
  font-size: 32px !important;
  font-weight: 900 !important;
  line-height: 1.35 !important;
}

.kyn-strategy .save-desc,
.kyn-strategy .save-empty,
.kyn-strategy .save-note {
  color: var(--kyn-ref-muted) !important;
  font-size: 20px !important;
  line-height: 1.65 !important;
}

.kyn-strategy .btn-primary,
.kyn-strategy .btn-secondary {
  min-height: 68px !important;
  padding: 0 34px !important;
  border: 1px solid var(--kyn-ref-line-strong) !important;
  background: #fff !important;
  color: var(--kyn-ref-ink) !important;
  font-size: 21px !important;
  font-weight: 900 !important;
}

.kyn-strategy .btn-primary {
  border-color: var(--kyn-ref-ink) !important;
  background: var(--kyn-ref-ink) !important;
  color: #fff !important;
}

.kyn-strategy table {
  width: 100% !important;
  border-collapse: collapse !important;
  font-size: 20px !important;
}

.kyn-strategy th,
.kyn-strategy td {
  padding: 24px 28px !important;
  border-bottom: 1px solid var(--kyn-ref-line) !important;
  font-size: 20px !important;
  line-height: 1.45 !important;
}

@media (max-width: 1100px) {
  .kyn-strategy {
    max-width: calc(100vw - 40px) !important;
    padding: 42px 0 80px !important;
  }

  .kyn-strategy .pagehead,
  .kyn-strategy .fgrid,
  .kyn-strategy .reducer .rh {
    grid-template-columns: 1fr !important;
    flex-direction: column !important;
    align-items: stretch !important;
  }

  .kyn-strategy .diag .dtop,
  .kyn-strategy .mini,
  .kyn-strategy .rmini {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }

  .kyn-strategy .qhead {
    grid-template-columns: 54px 1fr 28px !important;
    padding: 42px 32px 30px !important;
  }

  .kyn-strategy .qbody {
    padding: 0 32px 44px !important;
  }
}

/* ------------------------------------------------------------------
   Strategy page final reference override
   Matches the uploaded KYN strategy analysis reference screens.
------------------------------------------------------------------- */
body:has(.kyn-strategy) {
  background: #fff !important;
}

body:has(.kyn-strategy) main {
  background: #fff !important;
}

body:has(.kyn-strategy) header,
body:has(.kyn-strategy) .topbar,
body:has(.kyn-strategy) .dashboard-nav {
  min-height: 96px !important;
  background: #fff !important;
  border-bottom: 1px solid #ddd !important;
}

body:has(.kyn-strategy) header a,
body:has(.kyn-strategy) nav a {
  font-family: var(--sans) !important;
  letter-spacing: -0.02em !important;
}

.kyn-strategy {
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 92px 68px 120px !important;
  background: #fff !important;
  color: var(--ink, #1f2023) !important;
  font-family: var(--sans) !important;
  letter-spacing: -0.025em !important;
}

.kyn-strategy .crumb {
  margin: 0 0 28px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-family: var(--sans) !important;
  font-size: 18px !important;
  font-weight: 700 !important;
  letter-spacing: 0.28em !important;
  text-transform: uppercase !important;
}

.kyn-strategy .pagehead {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) auto !important;
  gap: 48px !important;
  align-items: end !important;
  margin: 0 0 58px !important;
  padding: 0 0 62px !important;
  border-bottom: 1px solid var(--line, #dedede) !important;
}

.kyn-strategy .pagehead h1 {
  margin: 0 !important;
  color: var(--ink, #1f2023) !important;
  font-family: var(--serif) !important;
  font-size: clamp(44px, 4.2vw, 72px) !important;
  font-weight: 400 !important;
  line-height: 1.12 !important;
  letter-spacing: -0.07em !important;
}

.kyn-strategy .pagehead .desc {
  margin-top: 18px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: clamp(18px, 1.35vw, 28px) !important;
  font-weight: 500 !important;
  line-height: 1.55 !important;
  letter-spacing: -0.035em !important;
}

.kyn-strategy .hero-cta {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-width: 276px !important;
  height: 92px !important;
  padding: 0 42px !important;
  background: var(--ink, #1f2023) !important;
  color: #fff !important;
  font-size: 28px !important;
  font-weight: 800 !important;
  letter-spacing: -0.035em !important;
  text-decoration: none !important;
}

.kyn-strategy .rule {
  display: none !important;
}

.kyn-strategy .block,
.kyn-strategy .card.block,
.kyn-strategy .qsec.block,
.kyn-strategy .save-panel.block,
.kyn-strategy .diag.block {
  border: 1px solid var(--line-strong, #cfcfcf) !important;
  border-radius: 0 !important;
  background: #fff !important;
  box-shadow: none !important;
}

.kyn-strategy .stepbar.block {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  min-height: 112px !important;
  margin: 0 0 42px !important;
  padding: 0 48px !important;
  border-left: 2px solid var(--gold-deep, #8a681d) !important;
  background: #fff !important;
}

.kyn-strategy .stepbar b {
  color: var(--ink, #1f2023) !important;
  font-size: 24px !important;
  font-weight: 800 !important;
  letter-spacing: -0.035em !important;
}

.kyn-strategy .stepbar span {
  margin-left: 18px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 22px !important;
  line-height: 1.45 !important;
}

.kyn-strategy .link,
.kyn-strategy a.link {
  color: var(--gold-deep, #8a681d) !important;
  font-size: 22px !important;
  font-weight: 800 !important;
  text-decoration: none !important;
}

.kyn-strategy .card.block {
  margin: 0 0 48px !important;
  padding: 0 !important;
}

.kyn-strategy .card-head {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  min-height: 150px !important;
  padding: 0 54px !important;
  border-bottom: 1px solid var(--line, #dedede) !important;
}

.kyn-strategy .card-head .t {
  color: var(--ink, #1f2023) !important;
  font-size: 30px !important;
  font-weight: 800 !important;
  letter-spacing: -0.04em !important;
}

.kyn-strategy .card-head .sub {
  display: block !important;
  margin-top: 12px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 21px !important;
  font-weight: 500 !important;
  line-height: 1.55 !important;
}

.kyn-strategy .mini {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  gap: 0 !important;
  margin: 0 !important;
  border-bottom: 1px solid var(--line, #dedede) !important;
}

.kyn-strategy .mini > div {
  min-height: 154px !important;
  padding: 36px 50px !important;
  border-right: 1px solid var(--line, #dedede) !important;
  background: #fff !important;
}

.kyn-strategy .mini > div:last-child {
  border-right: 0 !important;
}

.kyn-strategy .mini .l {
  color: var(--ink-faint, #8f939a) !important;
  font-size: 18px !important;
  font-weight: 600 !important;
  line-height: 1.45 !important;
}

.kyn-strategy .mini .n {
  margin-top: 18px !important;
  color: var(--ink, #1f2023) !important;
  font-family: var(--sans) !important;
  font-size: 34px !important;
  font-weight: 800 !important;
  line-height: 1.1 !important;
}

.kyn-strategy .planlist {
  padding: 0 !important;
}

.kyn-strategy .prow {
  display: flex !important;
  justify-content: space-between !important;
  gap: 40px !important;
  min-height: 78px !important;
  padding: 0 54px !important;
  border-bottom: 1px solid var(--line, #dedede) !important;
  align-items: center !important;
  color: var(--ink, #1f2023) !important;
  font-size: 22px !important;
}

.kyn-strategy .prow:last-child {
  border-bottom: 0 !important;
}

.kyn-strategy .pl-name strong {
  font-weight: 800 !important;
}

.kyn-strategy .pl-meta,
.kyn-strategy .prow.more {
  color: var(--ink-faint, #8f939a) !important;
  font-size: 20px !important;
}

.kyn-strategy .setbody {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
  gap: 52px 72px !important;
  padding: 58px 64px 66px !important;
}

.kyn-strategy .setbody > div:nth-child(2),
.kyn-strategy .setbody > .fgrid {
  grid-column: 1 / -1 !important;
}

.kyn-strategy .flab {
  display: block !important;
  margin-bottom: 16px !important;
  color: var(--ink, #1f2023) !important;
  font-size: 24px !important;
  font-weight: 800 !important;
  letter-spacing: -0.035em !important;
}

.kyn-strategy .unit-muted,
.kyn-strategy .muted {
  color: var(--ink-faint, #8f939a) !important;
  font-weight: 500 !important;
}

.kyn-strategy select.kyn,
.kyn-strategy input.kyn {
  width: 100% !important;
  min-height: 76px !important;
  padding: 0 30px !important;
  border: 1px solid var(--line-strong, #cfcfcf) !important;
  border-radius: 0 !important;
  background: #fff !important;
  color: var(--ink, #1f2023) !important;
  font-size: 25px !important;
  font-weight: 500 !important;
  outline: none !important;
}

.kyn-strategy input.kyn.short {
  max-width: 240px !important;
}

.kyn-strategy .checks {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 22px !important;
}

.kyn-strategy .chk {
  display: inline-flex !important;
  align-items: center !important;
  gap: 14px !important;
  min-height: 60px !important;
  padding: 0 26px !important;
  border: 1px solid color-mix(in srgb, var(--gold-deep, #8a681d) 45%, var(--line, #dedede)) !important;
  background: #fff !important;
  color: var(--ink, #1f2023) !important;
  font-size: 22px !important;
  font-weight: 600 !important;
}

.kyn-strategy .chk input {
  width: 20px !important;
  height: 20px !important;
  accent-color: var(--gold-deep, #8a681d) !important;
}

.kyn-strategy .fgrid {
  display: grid !important;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.7fr) !important;
  gap: 80px !important;
  align-items: start !important;
}

.kyn-strategy .small-grid {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 36px !important;
}

.kyn-strategy .small-grid .sl {
  margin-bottom: 10px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 20px !important;
  font-weight: 600 !important;
}

.kyn-strategy .diag.block {
  margin: 0 0 56px !important;
  padding: 0 !important;
  overflow: hidden !important;
}

.kyn-strategy .diag .dtop {
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  min-height: 236px !important;
}

.kyn-strategy .diag .dc {
  display: flex !important;
  flex-direction: column !important;
  justify-content: center !important;
  padding: 44px 60px !important;
  border-right: 1px solid var(--line, #dedede) !important;
  background: #fff !important;
}

.kyn-strategy .diag .dc:last-child {
  border-right: 0 !important;
}

.kyn-strategy .diag .dc.alert {
  background: color-mix(in srgb, var(--red, #9d3a2e) 7%, #fff) !important;
}

.kyn-strategy .diag .dc.save {
  background: color-mix(in srgb, var(--green-ink, #203c2f) 7%, #fff) !important;
}

.kyn-strategy .diag .dl {
  color: var(--ink-faint, #8f939a) !important;
  font-size: 25px !important;
  font-weight: 600 !important;
  letter-spacing: -0.04em !important;
}

.kyn-strategy .diag .dv {
  margin-top: 26px !important;
  color: var(--ink, #1f2023) !important;
  font-family: var(--serif) !important;
  font-size: clamp(52px, 4.4vw, 82px) !important;
  font-weight: 400 !important;
  line-height: 1 !important;
  letter-spacing: -0.07em !important;
}

.kyn-strategy .diag .alert .dv {
  color: var(--red, #9d3a2e) !important;
}

.kyn-strategy .diag .save .dv {
  color: var(--green-ink, #203c2f) !important;
}

.kyn-strategy .diag .dsub {
  margin-top: 22px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 20px !important;
  line-height: 1.45 !important;
}

.kyn-strategy .diag .dmeta {
  display: flex !important;
  align-items: center !important;
  gap: 34px !important;
  min-height: 104px !important;
  padding: 0 58px !important;
  border-top: 1px solid var(--line, #dedede) !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 25px !important;
  line-height: 1.45 !important;
}

.kyn-strategy .badge {
  display: inline-flex !important;
  align-items: center !important;
  gap: 12px !important;
  min-height: 54px !important;
  padding: 0 28px !important;
  border: 1px solid color-mix(in srgb, var(--red, #9d3a2e) 38%, var(--line, #dedede)) !important;
  border-radius: 0 !important;
  background: color-mix(in srgb, var(--red, #9d3a2e) 4%, #fff) !important;
  color: var(--red, #9d3a2e) !important;
  font-size: 24px !important;
  font-weight: 800 !important;
}

.kyn-strategy .badge .dot {
  width: 13px !important;
  height: 13px !important;
  background: var(--red, #9d3a2e) !important;
}

.kyn-strategy .qsec.block {
  margin: 64px 0 !important;
  padding: 0 !important;
  border: 1px solid var(--line-strong, #cfcfcf) !important;
}

.kyn-strategy .qhead {
  display: grid !important;
  grid-template-columns: 96px minmax(0, 1fr) 44px !important;
  gap: 54px !important;
  align-items: start !important;
  width: 100% !important;
  padding: 70px 62px 54px !important;
  background: #fff !important;
  border: 0 !important;
  text-align: left !important;
  cursor: pointer !important;
}

.kyn-strategy .qhead .qn {
  color: var(--gold-deep, #8a681d) !important;
  font-family: var(--serif) !important;
  font-size: 27px !important;
  font-weight: 400 !important;
  line-height: 1.35 !important;
}

.kyn-strategy .qhead h3 {
  color: var(--ink, #1f2023) !important;
  font-family: var(--serif) !important;
  font-size: clamp(34px, 3vw, 50px) !important;
  font-weight: 400 !important;
  line-height: 1.22 !important;
  letter-spacing: -0.075em !important;
}

.kyn-strategy .qhead .qd {
  display: block !important;
  margin-top: 18px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-family: var(--sans) !important;
  font-size: 25px !important;
  font-weight: 500 !important;
  line-height: 1.45 !important;
  letter-spacing: -0.035em !important;
}

.kyn-strategy .chev {
  position: relative !important;
  width: 38px !important;
  height: 38px !important;
  margin-top: 4px !important;
}

.kyn-strategy .chev::before {
  content: '' !important;
  position: absolute !important;
  inset: 10px 6px auto !important;
  width: 24px !important;
  height: 24px !important;
  border-top: 3px solid var(--ink-faint, #8f939a) !important;
  border-left: 3px solid var(--ink-faint, #8f939a) !important;
  transform: rotate(45deg) !important;
}

.kyn-strategy .qsec[data-open='false'] .chev::before {
  transform: rotate(225deg) !important;
}

.kyn-strategy .qbody {
  padding: 0 62px 68px 196px !important;
}

.kyn-strategy .bracket,
.kyn-strategy .reducer,
.kyn-strategy .method-panel,
.kyn-strategy .preserve,
.kyn-strategy .money-panel {
  border: 1px solid var(--line, #dedede) !important;
  border-left: 0 !important;
  border-radius: 0 !important;
  background: #fbfbfb !important;
  box-shadow: none !important;
}

.kyn-strategy .bracket {
  padding: 54px 58px !important;
}

.kyn-strategy .bracket-flow {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 34px !important;
  align-items: center !important;
  color: var(--ink, #1f2023) !important;
  font-size: 28px !important;
  font-weight: 800 !important;
}

.kyn-strategy .bracket-flow span {
  color: var(--ink-faint, #8f939a) !important;
  font-weight: 500 !important;
}

.kyn-strategy .bracket-bar {
  display: grid !important;
  grid-template-columns: 1fr 1fr 1fr 1.4fr 2.4fr !important;
  gap: 8px !important;
  margin: 58px 0 50px !important;
}

.kyn-strategy .bracket-seg::before {
  content: '' !important;
  display: block !important;
  height: 16px !important;
  margin-bottom: 28px !important;
  background: var(--line-strong, #cfcfcf) !important;
}

.kyn-strategy .bracket-seg.active::before {
  background: var(--gold-deep, #8a681d) !important;
}

.kyn-strategy .bracket-seg:last-child.active::before {
  background: var(--green-ink, #203c2f) !important;
}

.kyn-strategy .bracket-seg span {
  display: block !important;
  color: var(--ink, #1f2023) !important;
  font-size: 28px !important;
  font-weight: 800 !important;
}

.kyn-strategy .bracket-seg small {
  display: block !important;
  margin-top: 14px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 24px !important;
  line-height: 1.35 !important;
}

.kyn-strategy .bracket-metrics {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  margin-top: 40px !important;
  border-top: 1px solid var(--line, #dedede) !important;
}

.kyn-strategy .bracket-metrics > div {
  min-height: 154px !important;
  padding: 42px 0 26px 0 !important;
  border-right: 1px solid var(--line, #dedede) !important;
}

.kyn-strategy .bracket-metrics > div:not(:first-child) {
  padding-left: 40px !important;
}

.kyn-strategy .bracket-metrics > div:last-child {
  border-right: 0 !important;
}

.kyn-strategy .bracket-metrics span {
  display: block !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 24px !important;
}

.kyn-strategy .bracket-metrics strong {
  display: block !important;
  margin-top: 20px !important;
  color: var(--ink, #1f2023) !important;
  font-family: var(--serif) !important;
  font-size: 56px !important;
  font-weight: 400 !important;
  letter-spacing: -0.065em !important;
}

.kyn-strategy .bracket-metrics .red {
  color: var(--red, #9d3a2e) !important;
}

.kyn-strategy .bracket-quote {
  margin: 48px 0 0 !important;
  padding: 0 0 0 36px !important;
  border-left: 4px solid var(--line-strong, #cfcfcf) !important;
  color: var(--ink-soft, #4f555d) !important;
  font-size: 29px !important;
  font-weight: 500 !important;
  line-height: 1.7 !important;
  letter-spacing: -0.04em !important;
}

.kyn-strategy .bracket-targets {
  display: grid !important;
  gap: 16px !important;
  margin-top: 42px !important;
}

.kyn-strategy .bt-title {
  color: var(--ink, #1f2023) !important;
  font-size: 24px !important;
  font-weight: 800 !important;
}

.kyn-strategy .bt-row {
  display: grid !important;
  grid-template-columns: 1.4fr 1fr 1fr 1fr !important;
  gap: 22px !important;
  align-items: center !important;
  min-height: 72px !important;
  padding: 0 24px !important;
  border: 1px solid var(--line, #dedede) !important;
  background: #fff !important;
  color: var(--ink-soft, #4f555d) !important;
  font-size: 20px !important;
}

.kyn-strategy .bt-row strong {
  color: var(--ink, #1f2023) !important;
  font-weight: 800 !important;
}

.kyn-strategy .reducer {
  padding: 56px 58px !important;
  border-left: 3px solid var(--gold-deep, #8a681d) !important;
  background: #fbfbfb !important;
}

.kyn-strategy .reducer .rh {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) 164px !important;
  gap: 64px !important;
}

.kyn-strategy .section-label {
  margin-bottom: 18px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 16px !important;
  font-weight: 800 !important;
  letter-spacing: 0.28em !important;
  text-transform: uppercase !important;
}

.kyn-strategy .reducer .rt {
  color: var(--ink, #1f2023) !important;
  font-family: var(--serif) !important;
  font-size: 38px !important;
  font-weight: 400 !important;
  line-height: 1.25 !important;
  letter-spacing: -0.07em !important;
}

.kyn-strategy .reducer .rd {
  max-width: 880px !important;
  margin-top: 18px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 23px !important;
  font-weight: 500 !important;
  line-height: 1.65 !important;
}

.kyn-strategy .reducer .rpct {
  min-height: 132px !important;
  padding: 24px 18px !important;
  border: 1px solid var(--line, #dedede) !important;
  background: #fff !important;
  text-align: center !important;
}

.kyn-strategy .reducer .rl {
  color: var(--ink-faint, #8f939a) !important;
  font-size: 18px !important;
  font-weight: 600 !important;
}

.kyn-strategy .reducer .rv {
  margin-top: 16px !important;
  color: var(--gold-deep, #8a681d) !important;
  font-family: var(--serif) !important;
  font-size: 62px !important;
  font-weight: 400 !important;
  line-height: 1 !important;
  letter-spacing: -0.06em !important;
}

.kyn-strategy .reducer .rv span,
.kyn-strategy .reducer .pct-unit {
  margin-left: 4px !important;
  color: var(--ink-soft, #4f555d) !important;
  font-family: var(--serif) !important;
  font-size: 28px !important;
}

.kyn-strategy .reducer input[type='range'] {
  width: 100% !important;
  height: 44px !important;
  margin: 58px 0 26px !important;
  appearance: none !important;
  background: transparent !important;
}

.kyn-strategy .reducer input[type='range']::-webkit-slider-runnable-track {
  height: 6px !important;
  border-radius: 0 !important;
  background: var(--line-strong, #cfcfcf) !important;
}

.kyn-strategy .reducer input[type='range']::-webkit-slider-thumb {
  width: 26px !important;
  height: 26px !important;
  margin-top: -10px !important;
  border: 3px solid var(--gold-deep, #8a681d) !important;
  border-radius: 999px !important;
  background: #fff !important;
  box-shadow: none !important;
}

.kyn-strategy .presets {
  display: flex !important;
  gap: 16px !important;
  margin-bottom: 32px !important;
}

.kyn-strategy .preset {
  min-width: 76px !important;
  height: 56px !important;
  padding: 0 24px !important;
  border: 1px solid var(--line-strong, #cfcfcf) !important;
  border-radius: 0 !important;
  background: #fff !important;
  color: var(--ink-soft, #4f555d) !important;
  font-size: 21px !important;
  font-weight: 700 !important;
}

.kyn-strategy .preset.active {
  border-color: var(--ink, #1f2023) !important;
  background: var(--ink, #1f2023) !important;
  color: #fff !important;
}

.kyn-strategy .rmini {
  display: grid !important;
  grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
  gap: 0 !important;
  margin-top: 34px !important;
  border: 1px solid var(--line, #dedede) !important;
  background: #fff !important;
}

.kyn-strategy .rmini .rc {
  min-height: 112px !important;
  padding: 26px 24px !important;
  border-right: 1px solid var(--line, #dedede) !important;
  background: #fff !important;
}

.kyn-strategy .rmini .rc:last-child {
  border-right: 0 !important;
}

.kyn-strategy .rmini .rcl {
  color: var(--ink-faint, #8f939a) !important;
  font-size: 18px !important;
  font-weight: 600 !important;
}

.kyn-strategy .rmini .rcv {
  margin-top: 12px !important;
  color: var(--ink, #1f2023) !important;
  font-size: 30px !important;
  font-weight: 800 !important;
  line-height: 1.15 !important;
}

.kyn-strategy .rnote {
  margin-top: 24px !important;
  padding: 28px 32px !important;
  border: 1px solid var(--line, #dedede) !important;
  background: #fff !important;
  color: var(--ink-soft, #4f555d) !important;
  font-size: 22px !important;
  line-height: 1.65 !important;
}

.kyn-strategy .rnote-sub {
  display: block !important;
  margin-top: 28px !important;
  color: var(--ink-faint, #8f939a) !important;
}

.kyn-strategy .ttabs {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  margin-top: 38px !important;
  border: 1px solid var(--line, #dedede) !important;
}

.kyn-strategy .ttab {
  height: 74px !important;
  border: 0 !important;
  border-right: 1px solid var(--line, #dedede) !important;
  background: #fff !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 22px !important;
  font-weight: 800 !important;
}

.kyn-strategy .ttab:last-child {
  border-right: 0 !important;
}

.kyn-strategy .ttab.active {
  background: var(--ink, #1f2023) !important;
  color: #fff !important;
}

.kyn-strategy .strat,
.kyn-strategy .strategy-row {
  min-height: 132px !important;
  padding: 28px 34px !important;
  border: 1px solid var(--line, #dedede) !important;
  border-top: 0 !important;
  background: #fff !important;
}

.kyn-strategy .strat .title,
.kyn-strategy .strategy-title {
  color: var(--ink, #1f2023) !important;
  font-size: 27px !important;
  font-weight: 900 !important;
  line-height: 1.35 !important;
}

.kyn-strategy .strat .desc,
.kyn-strategy .strategy-desc {
  color: var(--ink-faint, #8f939a) !important;
  font-size: 21px !important;
  line-height: 1.55 !important;
}

.kyn-strategy .save-panel.block {
  margin: 64px 0 !important;
  padding: 0 !important;
  border: 2px solid var(--gold-deep, #8a681d) !important;
  background: #fff !important;
}

.kyn-strategy .save-panel-grid {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) 520px !important;
  gap: 72px !important;
  padding: 62px 58px 56px !important;
}

.kyn-strategy .save-kicker {
  color: var(--gold-deep, #8a681d) !important;
  font-size: 23px !important;
  font-weight: 900 !important;
}

.kyn-strategy .save-title {
  margin-top: 24px !important;
  color: var(--ink, #1f2023) !important;
  font-size: 38px !important;
  font-weight: 900 !important;
  line-height: 1.25 !important;
  letter-spacing: -0.045em !important;
}

.kyn-strategy .save-desc {
  margin-top: 24px !important;
  color: var(--ink-soft, #4f555d) !important;
  font-size: 25px !important;
  line-height: 1.62 !important;
}

.kyn-strategy .save-tags {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 14px !important;
  margin-top: 34px !important;
}

.kyn-strategy .save-tag {
  min-height: 50px !important;
  padding: 0 22px !important;
  border: 1px solid color-mix(in srgb, var(--gold-deep, #8a681d) 42%, var(--line, #dedede)) !important;
  color: var(--gold-deep, #8a681d) !important;
  background: color-mix(in srgb, var(--gold-deep, #8a681d) 5%, #fff) !important;
  display: inline-flex !important;
  align-items: center !important;
  font-size: 21px !important;
  font-weight: 800 !important;
}

.kyn-strategy .save-form {
  padding: 36px 42px !important;
  border: 1px solid var(--line, #dedede) !important;
  background: #fbfbfb !important;
}

.kyn-strategy .save-form label {
  color: var(--ink-faint, #8f939a) !important;
  font-size: 20px !important;
  font-weight: 700 !important;
}

.kyn-strategy .save-input {
  width: 100% !important;
  min-height: 64px !important;
  margin-top: 12px !important;
  padding: 0 18px !important;
  border: 1px solid var(--line-strong, #cfcfcf) !important;
  background: #fff !important;
  color: var(--ink, #1f2023) !important;
  font-size: 22px !important;
}

.kyn-strategy .save-row {
  display: flex !important;
  justify-content: space-between !important;
  margin-top: 28px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 21px !important;
}

.kyn-strategy .save-row strong {
  color: var(--ink, #1f2023) !important;
  font-weight: 900 !important;
}

.kyn-strategy .save-note {
  margin-top: 20px !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 19px !important;
  line-height: 1.55 !important;
}

.kyn-strategy .save-footer {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  gap: 32px !important;
  padding: 38px 58px !important;
  border-top: 1px solid var(--line, #dedede) !important;
  color: var(--ink-faint, #8f939a) !important;
  font-size: 23px !important;
}

.kyn-strategy .save-actions {
  display: flex !important;
  gap: 20px !important;
}

.kyn-strategy .btn-secondary,
.kyn-strategy .btn-primary {
  min-height: 72px !important;
  padding: 0 40px !important;
  border-radius: 0 !important;
  font-size: 23px !important;
  font-weight: 900 !important;
}

.kyn-strategy .btn-secondary {
  border: 1px solid var(--line-strong, #cfcfcf) !important;
  background: #fff !important;
  color: var(--ink, #1f2023) !important;
}

.kyn-strategy .btn-primary {
  border: 1px solid var(--ink, #1f2023) !important;
  background: var(--ink, #1f2023) !important;
  color: #fff !important;
}

.kyn-strategy .method-panel,
.kyn-strategy .money-panel,
.kyn-strategy .preserve {
  padding: 48px 54px !important;
}

.kyn-strategy table {
  font-size: 21px !important;
}

.kyn-strategy th,
.kyn-strategy td {
  padding: 26px 24px !important;
}

.kyn-strategy * {
  border-radius: 0 !important;
}

@media (max-width: 1180px) {
  .kyn-strategy {
    padding: 64px 36px 96px !important;
  }

  .kyn-strategy .pagehead,
  .kyn-strategy .setbody,
  .kyn-strategy .fgrid,
  .kyn-strategy .save-panel-grid {
    grid-template-columns: 1fr !important;
  }

  .kyn-strategy .diag .dtop,
  .kyn-strategy .mini,
  .kyn-strategy .rmini {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }

  .kyn-strategy .qbody {
    padding: 0 36px 48px !important;
  }
}

/* KYN strategy analysis final polish */
